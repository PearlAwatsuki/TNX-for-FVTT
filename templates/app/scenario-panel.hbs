<section class="tnx-scenario-panel">

    {{!-- 固定ヘッダ(全員向け表示層): 現在のアクト・フェイズ・シーン・シーンカード・登場中。
          本文がスクロールしてもここは常に見える(2026-08-15 タブ再構成)。
          登場中チップは「シーンの状態」なのでヘッダに残し、操作(手動登場・登場判定・チーム)は
          キャスト操作へ分離する --}}
    {{#if loaded}}
        <div class="scp-status">
            <div class="scp-act-line">
                <span class="scp-act-name">{{actName}}</span>
                <span class="scp-phase-badge">{{#if actStarted}}{{phaseLabel}}{{else}}開始前{{/if}}</span>
            </div>
            {{#if scene}}
                <div class="scp-scene-line">
                    <span class="scp-scene-title">SCENE {{scene.number}} : {{scene.name}}</span>
                </div>
                {{!-- 横並びのインライン(2026-08-16 是正で元の配置に戻した)。ラベル列グリッド案は
                      「登場」と値の間の空白が縦の近接に負けて誤読を生み、縦積みは空白が多く
                      不格好——いずれもユーザー指摘で撤回 --}}
                {{!-- 値(読ませたい内容)はラベルよりやや大きく明るい scp-meta-value。
                      ルーラーシーンはラベルを持たない値として同じ見た目で出す(2026-08-16) --}}
                <div class="scp-scene-meta">
                    {{#if scene.areaLabel}}<span class="scp-meta-item">エリア：<span class="scp-meta-value">{{scene.areaLabel}}</span></span>{{/if}}
                    {{#if scene.rulerScene}}
                        <span class="scp-meta-item"><span class="scp-meta-value">ルーラーシーン</span></span>
                    {{else if scene.playerLabel}}
                        <span class="scp-meta-item">シーンプレイヤー：<span class="scp-meta-value">{{scene.playerLabel}}</span></span>
                    {{/if}}
                    {{#if scene.appearanceLabel}}
                        <span class="scp-meta-item">登場：<span class="scp-meta-value">{{scene.appearanceLabel}}</span></span>
                    {{/if}}
                </div>
            {{/if}}
            {{!-- シーンカードは枠で囲んで1ブロックにまとめる(2026-08-16 ユーザー指示)。
                  ツールチップは付けない=このパネルには説明(キーワード/暗示)が既に出ている。
                  カード画像だけの HUD 側に付ける(同日ユーザー指摘で是正) --}}
            {{#if sceneCard}}
                <div class="scp-scene-card">
                    <img src="{{sceneCard.img}}" alt="{{sceneCard.nameText}}" />
                    <div class="scp-scene-card-info">
                        <div class="scp-scene-card-name">{{{sceneCard.name}}}</div>
                        {{#if sceneCard.keyword}}
                            <div class="scp-scene-card-field"><span class="scp-scene-card-label">キーワード</span>{{{sceneCard.keyword}}}</div>
                        {{/if}}
                        {{#if sceneCard.implication}}
                            <div class="scp-scene-card-field"><span class="scp-scene-card-label">暗示</span>{{{sceneCard.implication}}}</div>
                        {{/if}}
                    </div>
                </div>
            {{/if}}
            {{#if appearing.length}}
                <div class="scp-appearing">
                    <span class="scp-appearing-label">登場中:</span>
                    {{#each appearing as |actor|}}
                        <span class="scp-chip {{#if actor.hidden}}is-name-hidden{{/if}}">
                            {{actor.name}}
                            {{#if @root.isGM}}
                                <a class="tnx-icon-ctrl {{#if actor.hidden}}is-on{{/if}}" data-action="toggleAppearHidden" data-actor-id="{{actor.id}}" data-hidden="{{actor.hidden}}" title="{{#if actor.hidden}}名前を伏せている{{else}}名前を出している{{/if}}">
                                    <i class="fas {{#if actor.hidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i>
                                </a>
                                {{!-- ゴーストトグル(2026-08-22・名前非公開と同じ操作系。isGhost を持つ種別のみ) --}}
                                {{#if actor.canGhost}}
                                    <a class="tnx-icon-ctrl {{#if actor.ghost}}is-on{{/if}}" data-action="toggleAppearGhost" data-actor-id="{{actor.id}}" data-ghost="{{actor.ghost}}" title="{{#if actor.ghost}}ゴースト登場中{{else}}通常登場{{/if}}">
                                        <i class="fas fa-ghost"></i>
                                    </a>
                                {{/if}}
                                <a class="scp-chip-remove" data-action="exitActor" data-actor-id="{{actor.id}}" title="退場させる"><i class="fas fa-times"></i></a>
                            {{/if}}
                        </span>
                    {{/each}}
                </div>
            {{/if}}
        </div>
    {{else}}
        <p class="scp-empty">アクトが読み込まれていません。</p>
    {{/if}}

    {{!-- キャスト操作: 登場判定(PL)・手動登場(RL)・チーム。GM はキャストタブ・PL はヘッダ直下 --}}
    {{#*inline "castSection"}}
        {{#if canAppearanceCheck}}
            <button type="button" class="tnx-btn" data-action="appearanceCheck">
                <i class="fas fa-door-open"></i> 登場判定
            </button>
        {{/if}}
        {{!-- RL の手動登場(14-8): 登場判定を経ずに登場させる。名前を伏せるかは左のトグル --}}
        {{#if appearCandidateGroups.length}}
            <div class="scp-load-row scp-appear-add">
                <select name="appearActorId">
                    {{#each appearCandidateGroups as |group|}}
                        <optgroup label="{{group.label}}">
                            {{#each group.actors as |candidate|}}
                                <option value="{{candidate.id}}">{{candidate.name}}</option>
                            {{/each}}
                        </optgroup>
                    {{/each}}
                </select>
                <a class="tnx-icon-ctrl" data-action="toggleNewHideName" title="名前を出して登場"><i class="fas fa-eye"></i></a>
                <a class="tnx-icon-ctrl" data-action="toggleNewGhost" title="通常登場"><i class="fas fa-ghost"></i></a>
                <a class="tnx-icon-ctrl" data-action="appearActor" title="シーンに登場させる"><i class="fas fa-door-open"></i></a>
            </div>
        {{/if}}
        {{!-- チームは上演中の編成(2026-08-15 ユーザー指示＝開始前に出す必要はない) --}}
        {{#if actStarted}}
        <fieldset class="tnx-fieldset">
            <legend>チーム</legend>
            {{#each teams as |team|}}
                <div class="scp-team" data-team-id="{{team.id}}">
                    <div class="scp-send-row">
                        {{#if @root.isGM}}
                            <input type="text" class="scp-team-name" name="teamName" value="{{team.name}}" />
                        {{else}}
                            <span class="scp-send-label">{{team.name}}</span>
                        {{/if}}
                        {{!-- 「チームで登場/退場」は 2026-08-22 裁定でオミット=登場の適用は
                              RL の操作(手動登場・登場判定の成功)に一本化 --}}
                        {{#if team.canJoin}}
                            <a class="tnx-icon-ctrl" data-action="teamJoin" data-id="{{team.id}}" title="このチームに参加"><i class="fas fa-user-plus"></i></a>
                        {{/if}}
                        {{#if team.canLeave}}
                            <a class="tnx-icon-ctrl" data-action="teamLeave" data-id="{{team.id}}" title="チームから離脱"><i class="fas fa-user-minus"></i></a>
                        {{/if}}
                        {{#if @root.isGM}}
                            <a class="tnx-icon-ctrl" data-action="teamDelete" data-id="{{team.id}}" title="チームを解散"><i class="fas fa-trash"></i></a>
                        {{/if}}
                    </div>
                    {{#if team.members.length}}
                        <div class="scp-team-members">
                            {{#each team.members as |member|}}
                                <span class="scp-chip {{#if member.appearing}}is-appearing{{/if}}">
                                    {{member.name}}{{#if @root.isGM}}<a class="scp-chip-remove" data-action="teamRemoveMember" data-actor-id="{{member.id}}" title="チームから外す"><i class="fas fa-times"></i></a>{{/if}}
                                </span>
                            {{/each}}
                        </div>
                    {{/if}}
                    {{#if team.addCandidates.length}}
                        <div class="scp-load-row scp-team-add">
                            <select name="addMemberId">
                                {{#each team.addCandidates as |candidate|}}
                                    <option value="{{candidate.id}}">{{candidate.name}}</option>
                                {{/each}}
                            </select>
                            <a class="tnx-icon-ctrl" data-action="teamAddMember" data-id="{{team.id}}" title="メンバーを追加"><i class="fas fa-user-plus"></i></a>
                        </div>
                    {{/if}}
                </div>
            {{/each}}
            <div class="scp-load-row">
                <input type="text" name="newTeamName" placeholder="新しいチーム名" />
                <button type="button" class="tnx-btn tnx-btn--sm" data-action="teamCreate">結成</button>
            </div>
        </fieldset>
        {{/if}}
    {{/inline}}

    {{#*inline "actSection"}}
        <fieldset class="tnx-fieldset">
            <legend>アクト</legend>
            <div class="scp-load-row">
                <select name="actJournalId">
                    {{#each actOptions as |opt|}}
                        <option value="{{opt.id}}" {{#if opt.selected}}selected{{/if}}>{{opt.name}}</option>
                    {{/each}}
                </select>
                <button type="button" class="tnx-btn tnx-btn--sm" data-action="loadAct">読み込む</button>
            </div>
            <div class="scp-act-actions">
                {{#if loaded}}
                    {{#unless actStarted}}
                        <button type="button" class="tnx-btn" data-action="startAct">
                            <i class="fas fa-play"></i> アクトを開始
                        </button>
                    {{/unless}}
                    {{#if actStarted}}
                        <button type="button" class="tnx-btn" data-action="endAct">
                            <i class="fas fa-flag-checkered"></i> アクトを終了
                        </button>
                    {{/if}}
                {{/if}}
            </div>
        </fieldset>
    {{/inline}}

    {{#*inline "sceneSection"}}
        <fieldset class="tnx-fieldset">
            <legend>シーン</legend>
            {{#if canCloseScene}}
                <button type="button" class="tnx-btn" data-action="closeScene">
                    <i class="fas fa-door-closed"></i> シーンを閉じる
                </button>
            {{/if}}
            {{#if backstage}}
                <div class="scp-backstage">
                    <div class="scp-backstage-head">
                        <span class="scp-phase-label">舞台裏</span>
                        {{#if backstage.finished}}
                            <span class="scp-backstage-state">回しきりました</span>
                        {{else}}
                            <button type="button" class="tnx-btn tnx-btn--sm" data-action="backstageNext">
                                <i class="fas fa-rotate"></i> 舞台裏を回す
                            </button>
                        {{/if}}
                    </div>
                    {{#each backstage.queue as |member|}}
                        <div class="scp-backstage-row {{#if member.isSpot}}is-spot{{/if}}">
                            <span class="scp-backstage-name">{{member.name}}</span>
                            {{#if member.isExtra}}
                                <a class="tnx-icon-ctrl" data-action="backstageRemove" data-actor-id="{{member.id}}" title="舞台裏から外す"><i class="fas fa-times"></i></a>
                            {{/if}}
                        </div>
                    {{/each}}
                    {{#if backstage.addCandidates.length}}
                        <div class="scp-load-row">
                            <select name="backstageActorId">
                                {{#each backstage.addCandidates as |candidate|}}
                                    <option value="{{candidate.id}}">{{candidate.name}}</option>
                                {{/each}}
                            </select>
                            <a class="tnx-icon-ctrl" data-action="backstageAdd" title="舞台裏に加える"><i class="fas fa-user-plus"></i></a>
                        </div>
                    {{/if}}
                </div>
            {{/if}}
            {{!-- 巡回の消化状況(14-8): ハンドアウト順に、務めた人と次の既定を出す。
                  「なるべく務めていない人に回す」判断の材料であって、順番を縛るものではない。
                  毎シーンの操作ではないので既定で畳む(2026-08-15 タブ再構成) --}}
            {{#if rotation}}
                <div class="scp-rotation">
                    <a class="scp-disclosure-head" data-action="toggleRotation">
                        <i class="fas fa-chevron-{{#if rotationOpen}}down{{else}}right{{/if}}"></i>
                        <span class="scp-phase-label">巡回</span>
                    </a>
                    {{#if rotationOpen}}
                        {{#each rotation as |member|}}
                            <div class="scp-rotation-row {{#if member.isNext}}is-next{{/if}}">
                                <span class="scp-rotation-name {{#if member.done}}is-done{{/if}}">{{member.name}}</span>
                                {{#if member.done}}<span class="scp-rotation-state">済</span>{{/if}}
                                {{#if member.isNext}}<span class="scp-rotation-state">次</span>{{/if}}
                            </div>
                        {{/each}}
                    {{/if}}
                </div>
            {{/if}}
            {{#if nextScene}}
                <button type="button" class="tnx-btn" data-action="nextScene">
                    <i class="fas fa-forward"></i> 次のシーンへ{{#unless nextScene.rotating}}（{{nextScene.name}}）{{/unless}}
                </button>
            {{/if}}
            {{#if canLaunchEvent}}
                <button type="button" class="tnx-btn" data-action="launchEvent">
                    <i class="fas fa-bolt"></i> イベントシーンを起動する
                </button>
            {{/if}}
            {{#if canGoClimax}}
                <button type="button" class="tnx-btn" data-action="goClimax">
                    <i class="fas fa-fire"></i> クライマックスへ
                </button>
            {{/if}}
            {{!-- 全シーンの一覧は任意ジャンプ用＝毎シーンの操作ではないので既定で畳む
                  (2026-08-15 タブ再構成)。台本順の送りは上の「次のシーンへ」が担う --}}
            <div class="scp-scene-list">
                <a class="scp-disclosure-head" data-action="toggleSceneList">
                    <i class="fas fa-chevron-{{#if sceneListOpen}}down{{else}}right{{/if}}"></i>
                    <span class="scp-phase-label">シーン一覧</span>
                </a>
                {{#if sceneListOpen}}
                    {{#each sceneGroups as |group|}}
                        {{#if group.rows.length}}
                            <div class="scp-phase-group">
                                <div class="scp-phase-label">{{group.phaseLabel}}</div>
                                {{#each group.rows as |row|}}
                                    <div class="scp-scene-row {{#if row.isCurrent}}is-current{{/if}}">
                                        <span class="scp-scene-row-name">{{row.number}}. {{row.name}}</span>
                                        {{#unless row.isCurrent}}
                                            <a class="tnx-icon-ctrl" data-action="switchScene" data-scene-id="{{row.id}}" title="このシーンへ切り替え"><i class="fas fa-play-circle"></i></a>
                                        {{/unless}}
                                    </div>
                                {{/each}}
                            </div>
                        {{/if}}
                    {{/each}}
                {{/if}}
            </div>
        </fieldset>
    {{/inline}}

    {{#*inline "sendSection"}}
        <fieldset class="tnx-fieldset">
            <legend>配布・送信</legend>
            <div class="scp-send-row">
                <span class="scp-send-label">トレーラー</span>
                <a class="tnx-icon-ctrl" data-action="sendTrailer" title="チャットに送信"><i class="fas fa-paper-plane"></i></a>
            </div>
            {{#each handouts as |h|}}
                <div class="scp-send-row">
                    <span class="scp-send-label">{{h.title}}{{#if h.castLabel}}（{{h.castLabel}}）{{/if}}</span>
                    <a class="tnx-icon-ctrl" data-action="sendHandout" data-id="{{h.id}}" title="チャットに送信"><i class="fas fa-paper-plane"></i></a>
                </div>
            {{/each}}
            {{#each texts as |t|}}
                <div class="scp-send-row">
                    <span class="scp-send-label">{{t.title}}</span>
                    <a class="tnx-icon-ctrl" data-action="sendText" data-id="{{t.id}}" title="チャットに送信"><i class="fas fa-paper-plane"></i></a>
                </div>
            {{/each}}
        </fieldset>
    {{/inline}}

    {{#*inline "infoSection"}}
        <fieldset class="tnx-fieldset">
            <legend>情報</legend>
            {{#each infoItems as |item|}}
                <div class="scp-info-item">
                    <div class="scp-send-row">
                        <a class="tnx-icon-ctrl {{#if item.isPublic}}is-on{{/if}}" data-action="toggleInfoPublic" data-id="{{item.id}}" title="{{#if item.isPublic}}公開中{{else}}非公開{{/if}}">
                            <i class="fas {{#if item.isPublic}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
                        </a>
                        <span class="scp-send-label">{{item.title}}</span>
                        {{!-- 送信は公開状態でのみ(2026-08-18 ユーザー指示=非公開の情報はチャットに送れない) --}}
                        {{#if item.isPublic}}
                            <a class="tnx-icon-ctrl" data-action="sendInfo" data-id="{{item.id}}" title="チャットに送信"><i class="fas fa-paper-plane"></i></a>
                        {{/if}}
                    </div>
                    {{!-- 見出しは指定技能・その下に目標値が同列に並ぶ(目標値に上下関係は無い) --}}
                    {{#each item.groups as |group|}}
                        {{#if group.skillLabel}}
                            <div class="scp-info-skills">{{group.skillLabel}}</div>
                        {{/if}}
                        {{#each group.values as |value|}}
                            <div class="scp-info-content">
                                <a class="tnx-icon-ctrl {{#if value.isDisclosed}}is-on{{/if}}" data-action="toggleInfoDisclosed" data-id="{{item.id}}" data-content-id="{{group.contentId}}" data-tier-id="{{value.tierId}}" title="{{#if value.isDisclosed}}開示済み{{else}}未開示{{/if}}">
                                    <i class="fas {{#if value.isDisclosed}}fa-check-square{{else}}fa-square{{/if}}"></i>
                                </a>
                                <span class="scp-info-content-label">{{value.label}}</span>
                            </div>
                        {{/each}}
                    {{/each}}
                </div>
            {{/each}}
        </fieldset>
    {{/inline}}

    {{!-- 操作層(2026-08-15 タブ再構成)。開始後の RL は使用頻度別の3タブに分ける:
          進行(毎シーン=シーン送り+情報・既定)/キャスト(シーン切替時=登場・チーム)/
          アクト(セッション1回=読み込み・終了)。従来の並び替え裁定(2026-08-08 指示・
          2026-08-15 是正=開始後はシーン・情報を最優先・配布/送信は非表示・開始前は
          アクト→配布・送信)は、この頻度分けの中に引き継がれている。PL にタブはなく、
          キャスト操作(登場判定・チーム)をヘッダ直下に出す --}}
    {{#if isGM}}
        {{#if actStarted}}
            <nav class="scp-tabs" data-group="primary">
                <a class="item" data-action="tab" data-tab="flow" data-group="primary"><i class="fas fa-forward"></i> 進行</a>
                <a class="item" data-action="tab" data-tab="cast" data-group="primary"><i class="fas fa-users"></i> キャスト</a>
                <a class="item" data-action="tab" data-tab="act" data-group="primary"><i class="fas fa-book"></i> アクト</a>
            </nav>
            <div class="scp-body">
                <div class="tab" data-group="primary" data-tab="flow">
                    {{> sceneSection}}
                    {{> infoSection}}
                </div>
                <div class="tab" data-group="primary" data-tab="cast">
                    {{> castSection}}
                </div>
                <div class="tab" data-group="primary" data-tab="act">
                    {{> actSection}}
                </div>
            </div>
        {{else}}
            <div class="scp-body">
                {{> actSection}}
                {{#if loaded}}
                    {{> sendSection}}
                {{/if}}
            </div>
        {{/if}}
    {{else}}
        <div class="scp-body">
            {{> castSection}}
        </div>
    {{/if}}
</section>
