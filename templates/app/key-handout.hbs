<section class="key-handout-body">
{{#if allowed}}
    {{{content}}}
    {{#if published}}<p>公開済み</p>{{/if}}
    {{#if canPublish}}<div class="tnx-ctrl-strip"><a class="tnx-icon-ctrl" data-action="publish" title="公開" aria-label="公開"><i class="fas fa-eye" aria-hidden="true"></i></a></div>{{/if}}
{{else}}<p>このキーハンドアウトを閲覧する権限がありません。</p>{{/if}}
</section>
