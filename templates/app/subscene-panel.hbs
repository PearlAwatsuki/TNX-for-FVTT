<section class="tnx-subscene-panel">
    {{#if subScenes.length}}
        <div class="ssp-list">
            {{#each subScenes as |sub index|}}
                <div class="ssp-row {{#if sub.isCurrent}}is-current{{/if}}" data-id="{{sub.id}}" data-index="{{index}}">
                    <span class="ssp-grip" draggable="true" title="ドラッグで並び替え"><i class="fas fa-grip-vertical"></i></span>
                    <span class="ssp-thumb">
                        {{#if sub.background}}<img src="{{sub.background}}" alt="" />{{else}}<i class="fas fa-image"></i>{{/if}}
                    </span>
                    <input type="text" name="name" class="ssp-name" value="{{sub.name}}" />
                    <span class="ssp-order-btns">
                        <a class="tnx-icon-ctrl" data-action="moveUp" data-id="{{sub.id}}" title="上へ"><i class="fas fa-chevron-up"></i></a>
                        <a class="tnx-icon-ctrl" data-action="moveDown" data-id="{{sub.id}}" title="下へ"><i class="fas fa-chevron-down"></i></a>
                    </span>
                    <a class="tnx-icon-ctrl" data-action="pickBackground" data-id="{{sub.id}}" title="背景画像を変更"><i class="fas fa-image"></i></a>
                    <a class="tnx-icon-ctrl" data-action="applySubScene" data-id="{{sub.id}}" title="この背景に切り替え"><i class="fas fa-play-circle"></i></a>
                    <a class="tnx-icon-ctrl" data-action="deleteSubScene" data-id="{{sub.id}}" title="削除"><i class="fas fa-trash"></i></a>
                </div>
            {{/each}}
        </div>
    {{else}}
        <p class="ssp-empty">サブシーンはまだありません。</p>
    {{/if}}
    <div class="ssp-footer">
        <button type="button" class="tnx-btn tnx-btn--sm" data-action="clearOverride">
            <i class="fas fa-rotate-left"></i> 元の背景に戻す
        </button>
        <button type="button" class="tnx-btn" data-action="addFromCurrent">
            <i class="fas fa-plus"></i> 現在の背景から保存
        </button>
    </div>
</section>
