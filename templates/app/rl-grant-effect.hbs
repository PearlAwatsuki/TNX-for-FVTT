<div class="rl-request-body">

    {{!-- 付与するもの --}}
    <div class="form-group rl-form-group">
        <label class="rl-label">付与するもの</label>
        <select name="grantKind" class="rl-select">
            <option value="condition">状態</option>
            <option value="effect">効果</option>
        </select>
    </div>

    {{!-- 状態 --}}
    <div class="condition-section">
        <div class="form-group rl-form-group">
            <label class="rl-label">状態</label>
            <select name="conditionKind" class="rl-select">
                {{#each conditionGroups}}
                    <optgroup label="{{this.label}}">
                        {{#each this.kinds}}
                            <option value="{{this.kind}}">{{this.label}}</option>
                        {{/each}}
                    </optgroup>
                {{/each}}
            </select>
        </div>
    </div>

    {{!-- 効果(付与元＝アクトのプリセット / アイテムの効果 / その場で組む) --}}
    <div class="effect-section" hidden>
        <div class="form-group rl-form-group">
            <label class="rl-label">付与元</label>
            <select name="effectSource" class="rl-select">
                <option value="new">新規作成</option>
                {{#each effectSourceGroups}}
                    <optgroup label="{{this.label}}">
                        {{#each this.options}}
                            <option value="{{this.value}}">{{this.label}}</option>
                        {{/each}}
                    </optgroup>
                {{/each}}
            </select>
        </div>
        {{!-- 効果の見せ方はシステム標準の効果リストに揃える --}}
        <div class="form-group rl-form-group new-effect-section">
            <label class="rl-label">効果</label>
            <div class="tnx-item-list tnx-item-list--effects">
                <div class="tnx-item-list__row">
                    <div class="tnx-item-list__column--main">
                        <img class="effect-image new-effect-image" src="icons/svg/aura.svg" alt=""/>
                        <h4 class="new-effect-name disabled">未作成</h4>
                    </div>
                    <div class="tnx-item-list__column--summary new-effect-summary"></div>
                    <div class="tnx-item-list__column--controls">
                        <a class="tnx-icon-ctrl new-effect-edit" data-action="composeEffect" title="作成">
                            <i class="fas fa-plus"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{> "systems/tokyo-nova-axleration/templates/parts/target-picker.hbs"}}

    <footer class="rl-form-footer">
        <button type="submit" class="tnx-btn tnx-btn--primary rl-submit-btn">
            <i class="fas fa-hand-sparkles"></i> 付与する
        </button>
    </footer>

</div>
