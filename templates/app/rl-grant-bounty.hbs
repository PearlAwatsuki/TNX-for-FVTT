<div class="rl-request-body">

    {{!-- 読み込み元（アクトシートのプリセット・2026-07-20） --}}
    {{#if presetGroups.length}}
        <div class="form-group rl-form-group">
            <label class="rl-label">読み込み元</label>
            <select name="presetId" class="rl-select">
                <option value="">（手動設定）</option>
                {{#each presetGroups}}
                    <optgroup label="{{this.label}}">
                        {{#each this.presets}}
                            <option value="{{this.id}}">{{this.label}}</option>
                        {{/each}}
                    </optgroup>
                {{/each}}
            </select>
        </div>
    {{/if}}

    {{!-- 点数(負数=没収) --}}
    <div class="form-group rl-form-group">
        <label class="rl-label">点数</label>
        <div class="number-input-spinner">
            <button type="button" class="tnx-btn" data-action="decrement" aria-label="減少">−</button>
            <input type="number" name="amount" value="0" min="-99" max="99">
            <button type="button" class="tnx-btn" data-action="increment" aria-label="増加">＋</button>
        </div>
    </div>

    {{!-- 記述 --}}
    <div class="form-group rl-form-group">
        <label class="rl-label">記述</label>
        <input type="text" name="note" class="rl-input" placeholder="（省略可）">
    </div>

    {{!-- 対象アクター(判定要求と同じ登録方式) --}}
    <div class="form-group rl-form-group">
        <label class="rl-label">対象アクター</label>
        <div class="rl-targets-list">
            {{#if targetActors}}
                {{#each targetActors}}
                    <label class="rl-check-label rl-player-row">
                        <input type="checkbox" name="target_{{this.actorId}}">
                        <img class="rl-actor-img" src="{{this.img}}" alt="">
                        <span class="rl-player-name">{{this.actorName}}</span>
                    </label>
                {{/each}}
            {{else}}
                <p class="rl-no-players">キャストのアクターがいません</p>
            {{/if}}
        </div>
    </div>

    <footer class="rl-form-footer">
        <button type="submit" class="tnx-btn tnx-btn--primary rl-submit-btn">
            <i class="fas fa-coins"></i> 報酬点カードを送信
        </button>
    </footer>

</div>
