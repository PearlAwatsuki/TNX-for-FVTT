<div class="tnx-usage-sheet-inner">

    {{!-- ヘッダー: 種別バッジ + 名前 --}}
    <header class="usage-sheet-header">
        <span class="usage-type-badge usage-type--{{usage.type}}">{{typeLabel}}</span>
        <input class="usage-name-input" type="text" name="name"
               value="{{usage.name}}" placeholder="用途名"
               {{#unless editable}}disabled{{/unless}}>
    </header>

    {{!-- タブナビゲーション: 基本 / 発動 / 効果 --}}
    <nav class="sheet-tabs tabs" data-group="primary">
        <a class="item" data-action="tab" data-group="primary" data-tab="identity">基本</a>
        <a class="item" data-action="tab" data-group="primary" data-tab="activation">発動</a>
        {{#unless isFixedCheck}}
        <a class="item" data-action="tab" data-group="primary" data-tab="effects">効果</a>
        {{/unless}}
    </nav>

    <section class="sheet-body usage-sheet-body">

        {{!-- ① 基本タブ: 説明 --}}
        <div class="tab" data-group="primary" data-tab="identity">
            <div class="usage-form-section">
                <label class="usage-field-label">説明</label>
                <textarea class="usage-textarea" name="description" rows="8"
                          placeholder="（省略可）"
                          {{#unless editable}}disabled{{/unless}}>{{usage.description}}</textarea>
            </div>
        </div>

        {{!-- ② 発動タブ: タイミング・対象・射程・目標値・対決 --}}
        <div class="tab" data-group="primary" data-tab="activation">
            {{#if isFixedCheck}}
            {{!-- 固定値判定(エキストラ直下の一般技能のみ作成可・2026-07-04 確定)。
                 スート・レベル・カード・能力値を読まないため、通常判定の発動項目は持たない --}}
            <div class="usage-form-grid">
                <div class="usage-form-row">
                    <label class="usage-field-label">固定達成値 <i class="fas fa-circle-question" title="この値がそのまま達成値になります（カードも能力値も使いません）"></i></label>
                    <div class="number-input-spinner">
                        <button type="button" data-action="decrementFixedResult" class="tnx-btn" {{#unless editable}}disabled{{/unless}}>-</button>
                        <input type="number" name="fixedResult" value="{{usage.fixedResult}}"
                               {{#unless editable}}disabled{{/unless}}>
                        <button type="button" data-action="incrementFixedResult" class="tnx-btn" {{#unless editable}}disabled{{/unless}}>+</button>
                    </div>
                </div>
            </div>
            {{else}}
            <div class="usage-form-grid">

                {{#if isNpcAcquireType}}
                {{!-- NPC取得のモード(取得類型・明示選択=2026-07-04 裁定)。判定・目標値はモードで決まる:
                     エキストラ=判定なし / トループ・エニグマ=判定(目標値なし・達成値=人数/ポイント) /
                     分身=判定(目標値10・達成値10以上で成功) --}}
                <div class="usage-form-row">
                    <label class="usage-field-label">取得類型 <i class="fas fa-circle-question" title="エキストラ=判定なしでアウトフィットを取得し場に出します。トループ/エニグマ=判定の達成値が人数/エニグマポイントになります。分身=目標値10の判定で、成功すると呼び出せます"></i></label>
                    <select name="acquireMode" {{#unless editable}}disabled{{/unless}}>
                        {{#each acquireModeOptions}}
                        <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                        {{/each}}
                    </select>
                </div>
                {{#if isAcquireRefMode}}
                {{!-- 取得するアクター(トループ/エニグマ・2026-07-07 裁定=対象は用途側で設定)。
                     事前作成した種別一致のトループ級アクターをドロップで関連付ける --}}
                <div class="usage-form-row">
                    <label class="usage-field-label">取得するアクター <i class="fas fa-circle-question" title="使用時に呼び出す、事前に作成した{{acquireModeLabel}}のアクターです。判定後、人数/エニグマポイントの転記とトークン配置の対象になります"></i></label>
                    <div class="usage-field-with-fixed">
                        <span class="usage-acquire-actor-dropzone extra-actor-dropzone{{#unless hasAcquireActor}} extra-actor-dropzone--empty{{/unless}}" title="{{acquireModeLabel}}のアクターをドロップで設定">
                            {{#if hasAcquireActor}}{{acquireActorName}}{{else}}アクターをドロップ{{/if}}
                        </span>
                        {{#if hasAcquireActor}}
                        {{#if editable}}
                        <a data-action="acquireActorClear" title="関連付けを解除"><i class="fas fa-times"></i></a>
                        {{/if}}
                        {{/if}}
                    </div>
                </div>
                {{/if}}
                {{#if isAcquireBunshinMode}}
                {{!-- 分身は対象を設定せずそのまま召喚(2026-07-08 裁定)。複数体の可能性があるため
                     召喚数を設定する(トークンをこの数だけ配置) --}}
                <div class="usage-form-row">
                    <label class="usage-field-label">召喚数 <i class="fas fa-circle-question" title="呼び出す分身の数です。判定成功時、本体から再同期した分身のトークンをこの数だけ配置します"></i></label>
                    <div class="number-input-spinner">
                        <button type="button" data-action="decrementAcquireCount" class="tnx-btn" {{#unless editable}}disabled{{/unless}}>-</button>
                        <input type="number" name="acquireCount" value="{{acquireCount}}" min="1"
                               {{#unless editable}}disabled{{/unless}}>
                        <button type="button" data-action="incrementAcquireCount" class="tnx-btn" {{#unless editable}}disabled{{/unless}}>+</button>
                    </div>
                </div>
                {{/if}}
                {{/if}}

                {{!-- タイミング --}}
                <div class="usage-form-row">
                    <label class="usage-field-label">タイミング</label>
                    <select name="timing.value" {{#unless editable}}disabled{{/unless}}>
                        {{selectOptions skillOpts.timing selected=usage.timing.value}}
                    </select>
                </div>
                <div class="usage-form-row timing-action-sub">
                    <label class="usage-field-label">アクション種別</label>
                    <select name="timing.actionName" {{#unless editable}}disabled{{/unless}}>
                        {{selectOptions skillOpts.actions selected=usage.timing.actionName}}
                    </select>
                </div>
                <div class="usage-form-row timing-process-sub">
                    <label class="usage-field-label">プロセス種別</label>
                    <select name="timing.processName" {{#unless editable}}disabled{{/unless}}>
                        {{selectOptions skillOpts.processes selected=usage.timing.processName}}
                    </select>
                </div>
                <div class="usage-form-row timing-other-sub">
                    <label class="usage-field-label">タイミング（自由入力）</label>
                    <input type="text" name="timing.timingOther"
                           value="{{usage.timing.timingOther}}"
                           {{#unless editable}}disabled{{/unless}}>
                </div>

                {{!-- 対象（変更不可※をインライン） --}}
                <div class="usage-form-row">
                    <label class="usage-field-label">対象</label>
                    <div class="usage-field-with-fixed">
                        <select name="target" {{#unless editable}}disabled{{/unless}}>
                            {{selectOptions skillOpts.target selected=usage.target}}
                        </select>
                        <label class="usage-fixed-toggle" title="変更不可（※）：効果による対象変更を受けない">
                            <input type="checkbox" name="isFixedTarget" {{checked usage.isFixedTarget}}
                                   {{#unless editable}}disabled{{/unless}}><span>※</span>
                        </label>
                    </div>
                </div>
                <div class="usage-form-row target-other-sub">
                    <label class="usage-field-label">対象（自由入力）</label>
                    <input type="text" name="targetOther" value="{{usage.targetOther}}"
                           {{#unless editable}}disabled{{/unless}}>
                </div>

                {{!-- 射程（変更不可※をインライン） --}}
                <div class="usage-form-row">
                    <label class="usage-field-label">射程</label>
                    <div class="usage-field-with-fixed">
                        <select name="range" {{#unless editable}}disabled{{/unless}}>
                            {{selectOptions skillOpts.range selected=usage.range}}
                        </select>
                        <label class="usage-fixed-toggle" title="変更不可（※）：効果による射程変更を受けない">
                            <input type="checkbox" name="isFixedRange" {{checked usage.isFixedRange}}
                                   {{#unless editable}}disabled{{/unless}}><span>※</span>
                        </label>
                    </div>
                </div>
                <div class="usage-form-row range-other-sub">
                    <label class="usage-field-label">射程（自由入力）</label>
                    <input type="text" name="rangeOther" value="{{usage.rangeOther}}"
                           {{#unless editable}}disabled{{/unless}}>
                </div>

                {{!-- 目標値(NPC取得はモードで確定するため入力欄を出さない) --}}
                {{#unless isNpcAcquireType}}
                <div class="usage-form-row">
                    <label class="usage-field-label">目標値</label>
                    <select name="targetValue" {{#unless editable}}disabled{{/unless}}>
                        {{selectOptions skillOpts.targetValue selected=usage.targetValue}}
                    </select>
                </div>
                <div class="usage-form-row tv-number-sub">
                    <label class="usage-field-label">目標値（数字）</label>
                    <div class="number-input-spinner">
                        <button type="button" data-action="decrementTargetValue" class="tnx-btn" {{#unless editable}}disabled{{/unless}}>-</button>
                        <input type="number" name="targetValueNumber" value="{{usage.targetValueNumber}}"
                               {{#unless editable}}disabled{{/unless}}>
                        <button type="button" data-action="incrementTargetValue" class="tnx-btn" {{#unless editable}}disabled{{/unless}}>+</button>
                    </div>
                </div>
                <div class="usage-form-row tv-other-sub">
                    <label class="usage-field-label">目標値（自由入力）</label>
                    <input type="text" name="targetValueOther" value="{{usage.targetValueOther}}"
                           {{#unless editable}}disabled{{/unless}}>
                </div>
                {{else}}
                <div class="usage-form-row">
                    <label class="usage-field-label">目標値</label>
                    <span class="usage-info-line">{{#if isAcquireExtraMode}}なし（判定を行いません）{{else if (eq usage.acquireMode "bunshin")}}10 固定（達成値10以上で呼び出し成功）{{else}}なし（達成値がそのまま人数/エニグマポイント）{{/if}}</span>
                </div>
                {{/unless}}

                {{!-- 対決不可（インライントグル） --}}
                <div class="usage-form-row usage-toggle-row">
                    <label class="usage-toggle-inline" title="対象がこの判定に対決（リアクション）できない状態">
                        <input type="checkbox" name="isUnopposable" {{checked usage.isUnopposable}}
                               {{#unless editable}}disabled{{/unless}}>
                        <span>対決不可</span>
                    </label>
                </div>

            </div>

            {{!-- NPC取得(エキストラモード): 取得アイテム(小分類エキストラのアウトフィット)の
                 ドロップ欄(フェーズ10 の取得対象欄と同方式)。使用時に派生取得+場に出る --}}
            {{#if isAcquireExtraMode}}
            <div class="usage-form-section usage-acquire-section">
                <label class="usage-field-label">取得するエキストラ <i class="fas fa-circle-question" title="使用すると、ここに設定した小分類「エキストラ」のアウトフィットを派生データとして取得し、そのエキストラアクターを場に出します（アウトフィット側の「エキストラアクター」参照が場に出る対象です）"></i></label>
                <div class="usage-skill-ref-list">
                    {{#each acquireItemRows as |row|}}
                    <div class="usage-skill-ref-row">
                        <span class="usage-skill-ref-name{{#if row.missing}} usage-ref-missing{{/if}}">{{row.name}}</span>
                        {{#if @root.editable}}
                        <a class="tnx-row-btn tnx-row-btn--delete" data-action="acquireRefDelete" data-index="{{row.idx}}" title="削除"><i class="fas fa-trash"></i></a>
                        {{/if}}
                    </div>
                    {{/each}}
                </div>
                {{#if editable}}
                <div class="usage-acquire-dropzone">
                    <i class="fas fa-download"></i> ここに小分類「エキストラ」のアウトフィットをドロップ
                </div>
                {{else}}
                {{#unless acquireItemRows.length}}
                <p class="usage-empty-hint">（取得対象なし）</p>
                {{/unless}}
                {{/if}}
            </div>
            {{/if}}

            {{!-- 技能ベース用途のみ: 対決可能技能の情報表示 ＋ 自動入力。
                 対決欄の解釈(Check_Rules 2026-06-20): 無印の技能名は例示(他技能でのリアクションを
                 排除しない)・※付きは必須——説明はフットノートでなく title で示す --}}
            {{#if showSkillParams}}
            <div class="usage-form-section usage-confrontation-info">
                <label class="usage-field-label">対決（参加技能より） <i class="fas fa-circle-question" title="参加技能の対決欄に書かれた技能です。無印の技能は例示で、書かれていない技能でのリアクションを排除しません。※付きの技能は必須です"></i></label>
                {{#if confrontationCannot}}
                <p class="usage-info-line"><i class="fas fa-ban"></i> 対決不可の技能を含みます</p>
                {{/if}}
                {{#if confrontationReactions.length}}
                <p class="usage-info-line">{{#each confrontationReactions}}<span class="usage-info-tag">{{this}}</span>{{/each}}</p>
                {{else}}
                {{#unless confrontationCannot}}
                <p class="usage-empty-hint">（参加技能に対決の指定なし）</p>
                {{/unless}}
                {{/if}}
            </div>
            {{#if editable}}
            <div class="usage-autofill-row">
                <a class="tnx-btn tnx-btn--sm" data-action="autoFill" title="参加技能の固有値から発動パラメータと使用回数の消費（親×1＋使用回数制限つき参加技能×1）を導出して上書きします">
                    <i class="fas fa-wand-magic-sparkles"></i> 参加技能から自動入力
                </a>
            </div>
            {{/if}}
            {{/if}}

            {{!-- 使用回数の消費(11-6): 全ての消費はこの設定からのみ発生する(自動スキャン全廃・
                 親アイテム・組み合わせ技能も自動では消費されない)。D&D の Consumption 踏襲。
                 位置はタブ末尾(対決不可→対決情報→自動入力の連続を分断しない・2026-07-05 ユーザー確認) --}}
            <div class="usage-form-section usage-consume-section">
                <div class="usage-consume-header">
                    <label class="usage-field-label">使用回数の消費 <i class="fas fa-circle-question" title="実行時に消費するカウンターの設定です。親アイテムや組み合わせ技能の使用回数は自動では消費されません——消費したい分をここに設定します（判定用途は判定実行時・他の用途は使用時に消費）"></i></label>
                    {{#if editable}}
                    <a class="tnx-row-btn" data-action="consumeRowAdd" title="消費先を追加"><i class="fas fa-plus"></i></a>
                    {{/if}}
                </div>
                {{#each consumeRows as |row|}}
                <div class="usage-consume-row">
                    <select name="consumeType-{{row.idx}}" {{#unless @root.editable}}disabled{{/unless}}>
                        {{#each row.typeOptions}}
                        <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                        {{/each}}
                    </select>
                    {{#unless row.isParent}}
                    <select name="consumeItem-{{row.idx}}" {{#unless @root.editable}}disabled{{/unless}}>
                        <option value="">{{#if @root.hasConsumeActor}}── 対象 ──{{else}}(アクター所持時に選択可){{/if}}</option>
                        {{#each row.targetOptions}}
                        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
                        {{/each}}
                    </select>
                    {{/unless}}
                    <div class="number-input-spinner usage-consume-amount" title="消費量">
                        <button type="button" data-action="decrementConsumeAmount" data-row-index="{{row.idx}}" class="tnx-btn" {{#unless @root.editable}}disabled{{/unless}}>-</button>
                        <input type="number" name="consumeAmount-{{row.idx}}" value="{{row.amount}}" min="1" {{#unless @root.editable}}disabled{{/unless}}>
                        <button type="button" data-action="incrementConsumeAmount" data-row-index="{{row.idx}}" class="tnx-btn" {{#unless @root.editable}}disabled{{/unless}}>+</button>
                    </div>
                    {{#if @root.editable}}
                    <a class="tnx-row-btn tnx-row-btn--delete" data-action="consumeRowDelete" data-row-index="{{row.idx}}" title="削除"><i class="fas fa-trash"></i></a>
                    {{/if}}
                </div>
                {{/each}}
                {{#unless consumeRows.length}}
                <p class="usage-empty-hint">（消費なし）</p>
                {{/unless}}
            </div>
            {{/if}}
        </div>

        {{!-- ③ 効果タブ: 種別固有設定 ＋ 適用される効果(固定値判定では出さない) --}}
        {{#unless isFixedCheck}}
        <div class="tab" data-group="primary" data-tab="effects">

            {{!-- check・NPC取得(判定系モード): ベース技能・組み合わせ技能。攻撃は判定の一種 --}}
            {{#if (or isCheckType isAcquireCheckMode)}}
            {{> "systems/tokyo-nova-axleration/templates/app/usage-sheet-combo.hbs"}}
            {{/if}}

            {{!-- 攻撃プロファイル(2026-07-09): 攻撃は判定の一種。「攻撃に使う」トグルで系統・武器・種別を出す。
                 系統=Damage_Rules の3系統。武器・ダメージ種別は物理のみ(精神・社会は攻撃力を持たない) --}}
            {{#if isCheckType}}
            <div class="usage-form-section usage-attack-section">
                <label class="usage-toggle-inline" title="この判定を攻撃（ダメージを与える行動）として使う場合にオンにします。オフなら通常の判定です">
                    <input type="checkbox" name="isAttack" {{checked isAttack}} {{#unless editable}}disabled{{/unless}}>
                    <span>この判定を攻撃に使う</span>
                </label>
                {{#if isAttack}}
                <div class="usage-form-grid">
                    <div class="usage-form-row">
                        <label class="usage-field-label">攻撃の系統 <i class="fas fa-circle-question" title="物理=命中〈白兵〉〈射撃〉等・防御力で軽減。精神=〈心理〉・攻撃力/防御力なし。社会=〈圧力〉・舞台裏判定・報酬点軽減"></i></label>
                        <select name="damageCategory" {{#unless editable}}disabled{{/unless}}>
                            {{#each attackCategoryOptions}}
                            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                            {{/each}}
                        </select>
                    </div>
                    {{#if isAttackPhysical}}
                    <div class="usage-form-row">
                        <label class="usage-field-label">使用武器 <i class="fas fa-circle-question" title="未選択なら生身で攻撃します。2 個以上選ぶと攻撃力を合算します（複数武器合算能力の表現）"></i></label>
                        <div class="usage-skill-ref-list">
                            {{#each selectedWeapons}}
                            <div class="usage-skill-ref-row">
                                <span class="usage-skill-ref-name">{{this.name}}{{#if this.attackLabel}}（{{this.attackLabel}}）{{/if}}</span>
                                {{#if ../editable}}
                                <a class="usage-icon-btn" data-action="weaponRefDelete" data-idx="{{this.idx}}" title="この武器を外す"><i class="fas fa-times"></i></a>
                                {{/if}}
                            </div>
                            {{else}}
                            <p class="usage-empty-hint">── 生身 ──</p>
                            {{/each}}
                        </div>
                        {{#if editable}}
                        <div class="usage-skill-ref-add">
                            <select class="weapon-ref-select">
                                <option value="">── 武器・ヴィークルを追加 ──</option>
                                {{#each availableWeapons}}
                                <option value="{{this.id}}">{{this.name}}</option>
                                {{/each}}
                            </select>
                        </div>
                        {{/if}}
                    </div>
                    <div class="usage-form-row">
                        <label class="usage-field-label">ダメージ種別 <i class="fas fa-circle-question" title="単一/同一なら「武器に従う」で自動。複数武器で種別が別々のときはここでどちらかを選びます"></i></label>
                        <select name="damageType" {{#unless editable}}disabled{{/unless}}>
                            <option value="">── 武器に従う ──</option>
                            <option value="S" {{#if (eq usage.damageType "S")}}selected{{/if}}>S（斬撃）</option>
                            <option value="P" {{#if (eq usage.damageType "P")}}selected{{/if}}>P（貫通）</option>
                            <option value="I" {{#if (eq usage.damageType "I")}}selected{{/if}}>I（衝撃）</option>
                        </select>
                    </div>
                    {{/if}}
                </div>
                {{/if}}
            </div>
            {{/if}}

            {{!-- damageBoost / damageReduce: 計算式・カテゴリ --}}
            {{#if isDamageType}}
            <div class="usage-form-grid">
                <div class="usage-form-row">
                    <label class="usage-field-label">効果量（計算式）</label>
                    <input type="text" name="formula" value="{{usage.formula}}"
                           placeholder="例: @card, @card + 3, 5"
                           {{#unless editable}}disabled{{/unless}}>
                </div>
                <div class="usage-form-row">
                    <label class="usage-field-label">適用カテゴリ</label>
                    <select name="damageCategory" {{#unless editable}}disabled{{/unless}}>
                        <option value="">── 選択 ──</option>
                        <option value="physical" {{#if (eq usage.damageCategory "physical")}}selected{{/if}}>物理</option>
                        <option value="mental"   {{#if (eq usage.damageCategory "mental")}}selected{{/if}}>精神</option>
                    </select>
                </div>
            </div>
            {{/if}}

            {{!-- modification: 改造可能パラメータ --}}
            {{#if isModificationType}}
            <div class="usage-form-section">
                <label class="usage-field-label">改造可能パラメータ</label>
                <div class="usage-param-list">
                    {{#each usage.modifiableParams}}
                    <div class="usage-param-row">
                        <span class="usage-param-name">{{this}}</span>
                        {{#if ../editable}}
                        <a class="usage-icon-btn" data-action="paramDelete" data-idx="{{@index}}"
                           title="削除"><i class="fas fa-times"></i></a>
                        {{/if}}
                    </div>
                    {{else}}
                    <p class="usage-empty-hint">（なし）</p>
                    {{/each}}
                </div>
                {{#if editable}}
                <div class="usage-param-add">
                    <input class="param-input" type="text" placeholder="パラメータ名">
                    <a class="tnx-btn tnx-btn--sm" data-action="paramAdd">
                        <i class="fas fa-plus"></i> 追加
                    </a>
                </div>
                {{/if}}
            </div>
            {{/if}}

            {{!-- 適用される効果（ActiveEffect） --}}
            <div class="usage-form-section usage-effects-section">
                <label class="usage-field-label usage-section-head">適用される効果</label>
                <div class="usage-effect-list">
                    {{#each addedEffects}}
                    <div class="usage-skill-ref-row">
                        <span class="usage-skill-ref-name">{{this.name}}</span>
                        {{#if ../editable}}
                        <a class="usage-icon-btn" data-action="effectRemove" data-effect-id="{{this.id}}"
                           title="解除"><i class="fas fa-times"></i></a>
                        {{/if}}
                    </div>
                    {{else}}
                    <p class="usage-empty-hint">（適用される効果なし）</p>
                    {{/each}}
                </div>
                {{#if editable}}
                <div class="usage-skill-ref-add">
                    <select class="effect-select">
                        <option value="">── 追加する効果を選択 ──</option>
                        {{#each availableEffects}}
                        <option value="{{this.id}}">{{this.name}}</option>
                        {{/each}}
                    </select>
                </div>
                {{#unless hasAnyEffect}}
                <p class="usage-empty-hint">このアイテムに ActiveEffect がありません。<br>
                   アイテムシートの「エフェクト」タブで追加すると、ここで選択できます。</p>
                {{/unless}}
                {{/if}}
            </div>

        </div>
        {{/unless}}

    </section>
</div>
