<div class="tnx-usage-sheet-inner">

    {{!-- ヘッダー: 種別バッジ + 名前 --}}
    <header class="usage-sheet-header">
        <span class="usage-type-badge usage-type--{{usage.type}}">{{typeLabel}}</span>
        <input class="usage-name-input" type="text" name="name"
               value="{{usage.name}}" placeholder="用途名"
               {{#unless editable}}disabled{{/unless}}>
    </header>

    {{!-- タブナビゲーション: 基本 / 発動 / 効果 --}}
    <nav class="sheet-tabs tabs" data-group="primary">
        <a class="item" data-action="tab" data-group="primary" data-tab="identity">基本</a>
        <a class="item" data-action="tab" data-group="primary" data-tab="activation">発動</a>
        {{#unless isFixedCheck}}
        <a class="item" data-action="tab" data-group="primary" data-tab="effects">効果</a>
        {{/unless}}
    </nav>

    <section class="sheet-body usage-sheet-body">

        {{!-- ① 基本タブ: 説明 --}}
        <div class="tab" data-group="primary" data-tab="identity">
            <div class="usage-form-section">
                <label class="usage-field-label">説明</label>
                <textarea class="usage-textarea" name="description" rows="8"
                          placeholder="（省略可）"
                          {{#unless editable}}disabled{{/unless}}>{{usage.description}}</textarea>
            </div>
        </div>

        {{!-- ② 発動タブ: タイミング・対象・射程・目標値・対決 --}}
        <div class="tab" data-group="primary" data-tab="activation">
            {{#if isFixedCheck}}
            {{!-- 固定値判定(エキストラ直下の一般技能のみ作成可・2026-07-04 確定)。
                 スート・レベル・カード・能力値を読まないため、通常判定の発動項目は持たない --}}
            <div class="usage-form-grid">
                <div class="usage-form-row">
                    <label class="usage-field-label">固定達成値</label>
                    <div class="number-input-spinner">
                        <button type="button" data-action="decrementFixedResult" class="tnx-btn" {{#unless editable}}disabled{{/unless}}>-</button>
                        <input type="number" name="fixedResult" value="{{usage.fixedResult}}"
                               {{#unless editable}}disabled{{/unless}}>
                        <button type="button" data-action="incrementFixedResult" class="tnx-btn" {{#unless editable}}disabled{{/unless}}>+</button>
                    </div>
                </div>
            </div>
            {{else}}

            <fieldset class="tnx-fieldset">
                <legend>タイミング</legend>
                <div class="usage-form-grid">
                {{!-- タイミング --}}
                <div class="usage-form-row">
                    <label class="usage-field-label">タイミング</label>
                    <select name="timing.value" {{#unless editable}}disabled{{/unless}}>
                        {{selectOptions skillOpts.timing selected=usage.timing.value}}
                    </select>
                </div>
                <div class="usage-form-row timing-action-sub">
                    <label class="usage-field-label">アクション種別</label>
                    <select name="timing.actionName" {{#unless editable}}disabled{{/unless}}>
                        {{selectOptions skillOpts.actions selected=usage.timing.actionName}}
                    </select>
                </div>
                <div class="usage-form-row timing-process-sub">
                    <label class="usage-field-label">プロセス種別</label>
                    <select name="timing.processName" {{#unless editable}}disabled{{/unless}}>
                        {{selectOptions skillOpts.processes selected=usage.timing.processName}}
                    </select>
                </div>
                <div class="usage-form-row timing-other-sub">
                    <label class="usage-field-label">タイミング（自由入力）</label>
                    <input type="text" name="timing.timingOther"
                           value="{{usage.timing.timingOther}}"
                           {{#unless editable}}disabled{{/unless}}>
                </div>
                </div>
            </fieldset>

            <fieldset class="tnx-fieldset">
                <legend>対象・射程</legend>
                <div class="usage-form-grid">
                {{!-- 対象（変更不可※をインライン） --}}
                <div class="usage-form-row">
                    <label class="usage-field-label">対象</label>
                    <div class="usage-field-with-fixed">
                        <select name="target" {{#unless editable}}disabled{{/unless}}>
                            {{selectOptions skillOpts.target selected=usage.target}}
                        </select>
                        <label class="usage-fixed-toggle" title="変更不可">
                            <input type="checkbox" name="isFixedTarget" {{checked usage.isFixedTarget}}
                                   {{#unless editable}}disabled{{/unless}}><span>※</span>
                        </label>
                    </div>
                </div>
                <div class="usage-form-row target-other-sub">
                    <label class="usage-field-label">対象（自由入力）</label>
                    <input type="text" name="targetOther" value="{{usage.targetOther}}"
                           {{#unless editable}}disabled{{/unless}}>
                </div>

                {{!-- 射程（変更不可※をインライン） --}}
                <div class="usage-form-row">
                    <label class="usage-field-label">射程</label>
                    <div class="usage-field-with-fixed">
                        <select name="range" {{#unless editable}}disabled{{/unless}}>
                            {{selectOptions skillOpts.range selected=usage.range}}
                        </select>
                        <label class="usage-fixed-toggle" title="変更不可">
                            <input type="checkbox" name="isFixedRange" {{checked usage.isFixedRange}}
                                   {{#unless editable}}disabled{{/unless}}><span>※</span>
                        </label>
                    </div>
                </div>
                <div class="usage-form-row range-other-sub">
                    <label class="usage-field-label">射程（自由入力）</label>
                    <input type="text" name="rangeOther" value="{{usage.rangeOther}}"
                           {{#unless editable}}disabled{{/unless}}>
                </div>
                </div>
            </fieldset>

            <fieldset class="tnx-fieldset">
                <legend>目標値・対決</legend>
                <div class="usage-form-grid">
                {{!-- 目標値(NPC取得はモードで確定するため入力欄を出さない) --}}
                {{#unless isNpcAcquireType}}
                <div class="usage-form-row">
                    <label class="usage-field-label">目標値</label>
                    <select name="targetValue" {{#unless editable}}disabled{{/unless}}>
                        {{selectOptions skillOpts.targetValue selected=usage.targetValue}}
                    </select>
                </div>
                <div class="usage-form-row tv-number-sub">
                    <label class="usage-field-label">目標値（数字）</label>
                    <div class="number-input-spinner">
                        <button type="button" data-action="decrementTargetValue" class="tnx-btn" {{#unless editable}}disabled{{/unless}}>-</button>
                        <input type="number" name="targetValueNumber" value="{{usage.targetValueNumber}}"
                               {{#unless editable}}disabled{{/unless}}>
                        <button type="button" data-action="incrementTargetValue" class="tnx-btn" {{#unless editable}}disabled{{/unless}}>+</button>
                    </div>
                </div>
                <div class="usage-form-row tv-other-sub">
                    <label class="usage-field-label">目標値（自由入力・式）</label>
                    <input type="text" name="targetValueOther" value="{{usage.targetValueOther}}"
                           placeholder="式または自由文（例: 10 + @condition.magnitude）"
                           {{#unless editable}}disabled{{/unless}}>
                </div>
                {{else}}
                <div class="usage-form-row">
                    <label class="usage-field-label">目標値</label>
                    <span class="usage-info-line">{{#if isAcquireExtraMode}}なし（判定を行いません）{{else if (eq usage.acquireMode "bunshin")}}10 固定（達成値10以上で呼び出し成功）{{else}}なし（達成値がそのまま人数/エニグマポイント）{{/if}}</span>
                </div>
                {{/unless}}

                {{!-- 対決不可（インライントグル） --}}
                <div class="usage-form-row usage-toggle-row">
                    <label class="usage-toggle-inline">
                        <input type="checkbox" name="isUnopposable" {{checked usage.isUnopposable}}
                               {{#unless editable}}disabled{{/unless}}>
                        <span>対決不可</span>
                    </label>
                </div>
                </div>
            </fieldset>

            {{!-- 技能ベース用途のみ: 対決可能技能の情報表示 ＋ 自動入力。
                 対決欄の解釈(Check_Rules 2026-06-20): 無印の技能名は例示(他技能でのリアクションを
                 排除しない)・※付きは必須 --}}
            {{#if showSkillParams}}
            <fieldset class="tnx-fieldset usage-confrontation-info">
                <legend>対決（参加技能より）</legend>
                {{#if confrontationCannot}}
                <p class="usage-info-line"><i class="fas fa-ban"></i> 対決不可の技能を含みます</p>
                {{/if}}
                {{#if confrontationReactions.length}}
                <p class="usage-info-line">{{#each confrontationReactions}}<span class="usage-info-tag">{{this}}</span>{{/each}}</p>
                {{else}}
                {{#unless confrontationCannot}}
                <p class="usage-empty-hint">（参加技能に対決の指定なし）</p>
                {{/unless}}
                {{/if}}
            </fieldset>
            {{#if editable}}
            <div class="usage-autofill-row">
                <a class="tnx-btn tnx-btn--sm" data-action="autoFill">
                    <i class="fas fa-wand-magic-sparkles"></i> 参加技能から自動入力
                </a>
            </div>
            {{/if}}
            {{/if}}

            {{!-- 使用回数の消費(11-6): 全ての消費はこの設定からのみ発生する(自動スキャン全廃・
                 親アイテム・組み合わせ技能も自動では消費されない)。D&D の Consumption 踏襲。
                 位置はタブ末尾(対決不可→対決情報→自動入力の連続を分断しない・2026-07-05 ユーザー確認) --}}
            <fieldset class="tnx-fieldset usage-consume-section">
                <legend>使用回数の消費</legend>
                <div class="usage-consume-header">
                    {{#if editable}}
                    <a class="tnx-row-btn" data-action="consumeRowAdd" title="消費先を追加"><i class="fas fa-plus"></i></a>
                    {{/if}}
                </div>
                {{#each consumeRows as |row|}}
                <div class="usage-consume-row">
                    <select name="consumeType-{{row.idx}}" {{#unless @root.editable}}disabled{{/unless}}>
                        {{#each row.typeOptions}}
                        <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                        {{/each}}
                    </select>
                    {{#unless row.noTarget}}
                    <select name="consumeItem-{{row.idx}}" {{#unless @root.editable}}disabled{{/unless}}>
                        <option value="">{{#if @root.hasConsumeActor}}── 対象 ──{{else}}(アクター所持時に選択可){{/if}}</option>
                        {{#each row.targetOptions}}
                        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
                        {{/each}}
                    </select>
                    {{/unless}}
                    <div class="number-input-spinner usage-consume-amount" title="消費量">
                        <button type="button" data-action="decrementConsumeAmount" data-row-index="{{row.idx}}" class="tnx-btn" {{#unless @root.editable}}disabled{{/unless}}>-</button>
                        <input type="number" name="consumeAmount-{{row.idx}}" value="{{row.amount}}" min="1" {{#unless @root.editable}}disabled{{/unless}}>
                        <button type="button" data-action="incrementConsumeAmount" data-row-index="{{row.idx}}" class="tnx-btn" {{#unless @root.editable}}disabled{{/unless}}>+</button>
                    </div>
                    {{#if @root.editable}}
                    <a class="tnx-row-btn tnx-row-btn--delete" data-action="consumeRowDelete" data-row-index="{{row.idx}}" title="削除"><i class="fas fa-trash"></i></a>
                    {{/if}}
                </div>
                {{/each}}
                {{#unless consumeRows.length}}
                <p class="usage-empty-hint">（消費なし）</p>
                {{/unless}}
            </fieldset>
            {{/if}}
        </div>

        {{!-- ③ 効果タブ: 種別固有設定 ＋ 適用される効果(固定値判定では出さない) --}}
        {{#unless isFixedCheck}}
        <div class="tab" data-group="primary" data-tab="effects">

            {{!-- check・NPC取得(判定系モード): ベース技能・組み合わせ技能。攻撃は判定の一種 --}}
            {{#if isCheckType}}
            <fieldset class="tnx-fieldset">
                <legend>参加技能</legend>
                {{> "systems/tokyo-nova-axleration/templates/app/usage-sheet-combo.hbs"}}
            </fieldset>
            {{/if}}

            {{!-- 判定: 判定ボーナス(式)＋達成値の構成(全判定用途・2026-07-10 ユーザー確定)。
                 達成値 = カード+能力値+報酬点+判定バフ で構成され、ここで用途固有の加算(式)を足す --}}
            {{#if isCheckType}}
            <fieldset class="tnx-fieldset">
                <legend>判定</legend>
                {{!-- 判定モード(排他のためラジオ・2026-07-11): 通常=判定を行う / 再判定を付与 / 判定を修正。
                     判定用途である限り「なし」は存在しない(最初の選択肢=通常の判定) --}}
                <div class="usage-form-row usage-toggle-row">
                    <label class="usage-toggle-inline">
                        <input type="radio" name="checkMode" value="normal" {{checked (eq checkMode "normal")}} {{#unless editable}}disabled{{/unless}}>
                        <span>通常</span>
                    </label>
                    <label class="usage-toggle-inline">
                        <input type="radio" name="checkMode" value="grant" {{checked (eq checkMode "grant")}} {{#unless editable}}disabled{{/unless}}>
                        <span>再判定を付与</span>
                    </label>
                    <label class="usage-toggle-inline">
                        <input type="radio" name="checkMode" value="modify" {{checked (eq checkMode "modify")}} {{#unless editable}}disabled{{/unless}}>
                        <span>判定を修正</span>
                    </label>
                    <label class="usage-toggle-inline">
                        <input type="radio" name="checkMode" value="suitChange" {{checked (eq checkMode "suitChange")}} {{#unless editable}}disabled{{/unless}}>
                        <span>スートを変更</span>
                    </label>
                </div>
                {{#if (eq checkMode "normal")}}
                {{!-- 再判定可能・スート変更可能は「判定を行う用途」の性質のため通常モードでのみ表示 --}}
                <div class="usage-form-row usage-toggle-row">
                    <label class="usage-toggle-inline">
                        <input type="checkbox" name="allowRecheck" {{checked usage.allowRecheck}}
                               {{#unless editable}}disabled{{/unless}}>
                        <span>再判定可能</span>
                    </label>
                    <label class="usage-toggle-inline">
                        <input type="checkbox" name="allowSuitChange" {{checked usage.allowSuitChange}}
                               {{#unless editable}}disabled{{/unless}}>
                        <span>スート変更可能</span>
                    </label>
                </div>
                {{/if}}
                <label class="usage-field-label">この用途の判定修正値</label>
                <input type="text" name="checkBonusSelf" value="{{checkBonusSelf}}"
                       placeholder="式（例: @item.self.system.levelTotal、2）"
                       {{#unless editable}}disabled{{/unless}}>
                <label class="usage-field-label">判定ボーナス（供給元つき・追加）</label>
                {{> "systems/tokyo-nova-axleration/templates/app/usage-sheet-bonus-rows.hbs"
                    rows=checkBonusRows prefix="checkBonus" addAction="checkBonusAdd" deleteAction="checkBonusDelete"
                    addLabel="判定ボーナスを追加" placeholder="式（例: 2、@item.<識別キー>.system.level）"
                    emptyHint="（追加の判定ボーナスなし）" editable=editable}}
                <p class="usage-formula-line">達成値 ＝ カード ＋ 能力値 ＋ 報酬点 ＋ 判定バフ ＋ 判定修正値 ＋ 判定ボーナス</p>
            </fieldset>

            {{!-- リアクション(2026-07-15): リアクション用途の追加挙動。当面は全用途に表示。 --}}
            <fieldset class="tnx-fieldset">
                <legend>リアクション</legend>
                <div class="usage-form-row usage-toggle-row">
                    <label class="usage-toggle-inline">
                        <input type="checkbox" name="reactionAreaAttack" {{checked usage.reactionAreaAttack}}
                               {{#unless editable}}disabled{{/unless}}>
                        <span>範囲攻撃へのリアクション</span>
                    </label>
                    <label class="usage-toggle-inline">
                        <input type="checkbox" name="reactionFailsAttack" {{checked usage.reactionFailsAttack}}
                               {{#unless editable}}disabled{{/unless}}>
                        <span>攻撃を失敗させる</span>
                    </label>
                    <label class="usage-toggle-inline">
                        <input type="checkbox" name="covering" {{checked usage.covering}}
                               {{#unless editable}}disabled{{/unless}}>
                        <span>カバー</span>
                    </label>
                </div>
            </fieldset>

            {{!-- 攻撃プロファイル(2026-07-09): 攻撃は判定の一種。「攻撃に使う」トグルで系統・武器・種別を出す。
                 系統=Damage_Rules の3系統。武器・ダメージ種別は物理のみ(精神・社会は攻撃力を持たない) --}}
            <fieldset class="tnx-fieldset usage-attack-section">
                <legend>攻撃</legend>
                {{!-- 攻撃モード(排他のためラジオ・2026-07-11): なし=通常判定 / 攻撃に使う / ダメージを修正 --}}
                <div class="usage-form-row usage-toggle-row">
                    <label class="usage-toggle-inline">
                        <input type="radio" name="attackMode" value="none" {{checked (eq attackMode "none")}} {{#unless editable}}disabled{{/unless}}>
                        <span>なし</span>
                    </label>
                    <label class="usage-toggle-inline">
                        <input type="radio" name="attackMode" value="attack" {{checked (eq attackMode "attack")}} {{#unless editable}}disabled{{/unless}}>
                        <span>攻撃に使う</span>
                    </label>
                    <label class="usage-toggle-inline">
                        <input type="radio" name="attackMode" value="modifyDamage" {{checked (eq attackMode "modifyDamage")}} {{#unless editable}}disabled{{/unless}}>
                        <span>ダメージを修正</span>
                    </label>
                </div>
                {{#if isModifyDamage}}
                <div class="usage-form-section">
                    <label class="usage-field-label">ダメージ修正（式）</label>
                    <input type="text" name="damageBonusSelf" value="{{damageBonusSelf}}"
                           placeholder="式（例: -@item.self.system.levelTotal、@card、-5）"
                           {{#unless editable}}disabled{{/unless}}>
                </div>
                {{/if}}
                {{#if isAttack}}
                <div class="usage-form-section">
                    <div class="usage-form-row">
                        <label class="usage-field-label">攻撃の系統</label>
                        <select name="damageCategory" {{#unless editable}}disabled{{/unless}}>
                            {{#each attackCategoryOptions}}
                            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                            {{/each}}
                        </select>
                    </div>
                    {{#if isAttackPhysical}}
                    {{!-- スタン可能: 物理攻撃のみの能力ゲート。ON の物理攻撃は攻撃の判定ダイアログで
                         「スタンとして行う」を宣言できる（説得は精神攻撃で常時・canStun 不要） --}}
                    <div class="usage-form-row usage-toggle-row">
                        <label class="usage-toggle-inline">
                            <input type="checkbox" name="canStun" {{checked usage.canStun}}
                                   {{#unless editable}}disabled{{/unless}}>
                            <span>スタン可能</span>
                        </label>
                    </div>
                    <div class="usage-form-row">
                        <label class="usage-field-label">使用武器</label>
                        <div class="usage-skill-ref-list">
                            <div class="usage-skill-ref-row">
                                <span class="usage-skill-ref-name">{{sheetAttackWeapon.name}}（{{sheetAttackWeapon.attackLabel}}）</span>
                            </div>
                            {{#each selectedWeapons}}
                            <div class="usage-skill-ref-row">
                                <span class="usage-skill-ref-name">＋{{this.name}}{{#if this.attackLabel}}（{{this.attackLabel}}）{{/if}}</span>
                                {{#if ../editable}}
                                <a class="usage-icon-btn" data-action="weaponRefDelete" data-idx="{{this.idx}}" title="この武器を外す"><i class="fas fa-times"></i></a>
                                {{/if}}
                            </div>
                            {{/each}}
                        </div>
                        {{#if editable}}
                        <div class="usage-skill-ref-add">
                            <select class="weapon-ref-select">
                                <option value="">── 武器・ヴィークルを追加 ──</option>
                                {{#each availableWeapons}}
                                <option value="{{this.id}}">{{this.name}}</option>
                                {{/each}}
                            </select>
                        </div>
                        {{/if}}
                    </div>
                    <div class="usage-form-row">
                        <label class="usage-field-label">ダメージ種別</label>
                        <select name="damageType" {{#unless editable}}disabled{{/unless}}>
                            <option value="">── 武器に従う ──</option>
                            <option value="S" {{#if (eq usage.damageType "S")}}selected{{/if}}>S（斬撃）</option>
                            <option value="P" {{#if (eq usage.damageType "P")}}selected{{/if}}>P（貫通）</option>
                            <option value="I" {{#if (eq usage.damageType "I")}}selected{{/if}}>I（衝撃）</option>
                        </select>
                    </div>
                    {{/if}}
                    <label class="usage-field-label">この用途のダメージ修正値</label>
                    <input type="text" name="damageBonusSelf" value="{{damageBonusSelf}}"
                           placeholder="式（例: @item.self.system.attack.total）"
                           {{#unless editable}}disabled{{/unless}}>
                    <label class="usage-field-label">ダメージ修正（供給元つき・追加）</label>
                    {{> "systems/tokyo-nova-axleration/templates/app/usage-sheet-bonus-rows.hbs"
                        rows=damageBonusRows prefix="damageBonus" addAction="damageBonusAdd" deleteAction="damageBonusDelete"
                        addLabel="ダメージ修正を追加" placeholder="式（例: @item.<武器の識別キー>.system.attack.value）"
                        emptyHint="（追加のダメージ修正なし）" editable=editable}}
                    <p class="usage-formula-line">{{#if isAttackPhysical}}ダメージ ＝ ダメージカード ＋ 攻撃力{{#if selectedWeapons.length}}（合算）{{else}}（生身）{{/if}} ＋ ダメージ修正値 ＋ ダメージ修正 − 軽減{{else}}ダメージ ＝ ダメージカード ＋ ダメージ修正値 ＋ ダメージ修正（精神／社会は攻撃力・防御力なし）{{/if}}</p>
                </div>
                {{/if}}
            </fieldset>
            {{/if}}

            {{!-- 宣言: 判定/ダメージへの修正(2026-07-12 ユーザー確定・バフ宣言の表現)。
                 判定用途とレイアウトを揃えた 2 fieldset・チェックボックスは独立(排他にしない) --}}
            {{#if isDeclarationType}}
            <fieldset class="tnx-fieldset">
                <legend>判定</legend>
                {{!-- 再判定を付与(2026-07-13 ユーザー確定): 宣言は判定でない=参加技能が無いため、
                     組み合わせなしの素の再判定権を事後付与する(check 用途の付与は親技能を組み合わせる) --}}
                <div class="usage-form-row usage-toggle-row">
                    <label class="usage-toggle-inline">
                        <input type="checkbox" name="grantRecheck" {{checked usage.grantRecheck}}
                               {{#unless editable}}disabled{{/unless}}>
                        <span>再判定を付与</span>
                    </label>
                </div>
                <div class="usage-form-row usage-toggle-row">
                    <label class="usage-toggle-inline">
                        <input type="checkbox" name="modifyCheck" {{checked usage.modifyCheck}}
                               {{#unless editable}}disabled{{/unless}}>
                        <span>判定を修正</span>
                    </label>
                </div>
                {{#if usage.modifyCheck}}
                <label class="usage-field-label">判定修正（式）</label>
                <input type="text" name="checkBonusSelf" value="{{checkBonusSelf}}"
                       placeholder="式（例: @item.self.system.levelTotal、2、-3）"
                       {{#unless editable}}disabled{{/unless}}>
                {{/if}}
                <div class="usage-form-row usage-toggle-row">
                    <label class="usage-toggle-inline">
                        <input type="checkbox" name="grantSuitChange" {{checked usage.grantSuitChange}}
                               {{#unless editable}}disabled{{/unless}}>
                        <span>スートを変更（次の判定）</span>
                    </label>
                </div>
            </fieldset>

            <fieldset class="tnx-fieldset">
                <legend>ダメージ</legend>
                <div class="usage-form-row usage-toggle-row">
                    <label class="usage-toggle-inline">
                        <input type="checkbox" name="modifyDamage" {{checked usage.modifyDamage}}
                               {{#unless editable}}disabled{{/unless}}>
                        <span>ダメージを修正</span>
                    </label>
                </div>
                {{#if usage.modifyDamage}}
                <label class="usage-field-label">ダメージ修正（式）</label>
                <input type="text" name="damageBonusSelf" value="{{damageBonusSelf}}"
                       placeholder="式（例: -@item.self.system.levelTotal、@card、-5）"
                       {{#unless editable}}disabled{{/unless}}>
                {{/if}}
            </fieldset>
            {{/if}}

            {{!-- NPC取得(Troops.md・2026-07-13 タイプ→設定へ移管): check/declaration の
                 どちらの用途にも設定できる(エキストラ=判定なし・トループ/エニグマ/分身=判定。
                 実行はモード駆動で従来どおり)。設定できるのはトループ取得技能とアウトフィット --}}
            {{#if canNpcAcquire}}
            <fieldset class="tnx-fieldset">
                <legend>NPC取得</legend>
                <div class="usage-form-row usage-toggle-row">
                    <label class="usage-toggle-inline">
                        <input type="checkbox" name="npcAcquire" {{checked usage.npcAcquire}}
                               {{#unless editable}}disabled{{/unless}}>
                        <span>NPC取得を行う</span>
                    </label>
                </div>
                {{#if isNpcAcquireType}}
                <div class="usage-form-grid">
                {{!-- NPC取得のモード(取得類型・明示選択=2026-07-04 裁定)。判定・目標値はモードで決まる:
                     エキストラ=判定なし / トループ・エニグマ=判定(目標値なし・達成値=人数/ポイント) /
                     分身=判定(目標値10・達成値10以上で成功) --}}
                <div class="usage-form-row">
                    <label class="usage-field-label">取得類型</label>
                    <select name="acquireMode" {{#unless editable}}disabled{{/unless}}>
                        {{#each acquireModeOptions}}
                        <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                        {{/each}}
                    </select>
                </div>
                {{#if isAcquireRefMode}}
                {{!-- 取得するアクター(トループ/エニグマ・2026-07-07 裁定=対象は用途側で設定)。
                     事前作成した種別一致のトループ級アクターをドロップで関連付ける --}}
                <div class="usage-form-row">
                    <label class="usage-field-label">取得するアクター</label>
                    <div class="usage-field-with-fixed">
                        <span class="usage-acquire-actor-dropzone extra-actor-dropzone{{#unless hasAcquireActor}} extra-actor-dropzone--empty{{/unless}}">
                            {{#if hasAcquireActor}}{{acquireActorName}}{{else}}アクターをドロップ{{/if}}
                        </span>
                        {{#if hasAcquireActor}}
                        {{#if editable}}
                        <a data-action="acquireActorClear" title="関連付けを解除"><i class="fas fa-times"></i></a>
                        {{/if}}
                        {{/if}}
                    </div>
                </div>
                {{/if}}
                {{#if isAcquireBunshinMode}}
                {{!-- 分身は対象を設定せずそのまま召喚(2026-07-08 裁定)。複数体の可能性があるため
                     召喚数を設定する(トークンをこの数だけ配置) --}}
                <div class="usage-form-row">
                    <label class="usage-field-label">召喚数</label>
                    <div class="number-input-spinner">
                        <button type="button" data-action="decrementAcquireCount" class="tnx-btn" {{#unless editable}}disabled{{/unless}}>-</button>
                        <input type="number" name="acquireCount" value="{{acquireCount}}" min="1"
                               {{#unless editable}}disabled{{/unless}}>
                        <button type="button" data-action="incrementAcquireCount" class="tnx-btn" {{#unless editable}}disabled{{/unless}}>+</button>
                    </div>
                </div>
                {{/if}}
                    </div>
                {{#if isAcquireExtraMode}}
            <div class="usage-form-section usage-acquire-section">
                <label class="usage-field-label">取得するエキストラ</label>
                <div class="usage-skill-ref-list">
                    {{#each acquireItemRows as |row|}}
                    <div class="usage-skill-ref-row">
                        <span class="usage-skill-ref-name{{#if row.missing}} usage-ref-missing{{/if}}">{{row.name}}</span>
                        {{#if @root.editable}}
                        <a class="tnx-row-btn tnx-row-btn--delete" data-action="acquireRefDelete" data-index="{{row.idx}}" title="削除"><i class="fas fa-trash"></i></a>
                        {{/if}}
                    </div>
                    {{/each}}
                </div>
                {{#if editable}}
                <div class="usage-acquire-dropzone">
                    <i class="fas fa-download"></i> ここに小分類「エキストラ」のアウトフィットをドロップ
                </div>
                {{else}}
                {{#unless acquireItemRows.length}}
                <p class="usage-empty-hint">（取得対象なし）</p>
                {{/unless}}
                {{/if}}
            </div>
            {{/if}}
                {{/if}}
            </fieldset>
            {{/if}}

            {{!-- 回復(2026-07-13): BS/戦闘不能/負傷を除去する回復・治療系の設定(check/declaration 両対応)。
                 範囲=大分類→小分類の行(OR)・除外=タグ(タグ自身+そのタグを与える負傷を除く) --}}
            {{#if isRecoveryCapable}}
            <fieldset class="tnx-fieldset usage-recovery-section">
                <legend>回復</legend>
                <div class="usage-form-row usage-toggle-row">
                    <label class="usage-toggle-inline">
                        <input type="checkbox" name="recovery" {{checked usage.recovery}}
                               {{#unless editable}}disabled{{/unless}}>
                        <span>回復を行う</span>
                    </label>
                </div>
                {{#if isRecovery}}
                <label class="usage-field-label">回復対象の範囲</label>
                <div class="usage-recovery-rows">
                    {{#each recoveryRows as |row|}}
                    <div class="usage-consume-row">
                        <select name="recoveryGroup-{{row.idx}}" {{#unless @root.editable}}disabled{{/unless}}>
                            {{#each row.groupOptions}}
                            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                            {{/each}}
                        </select>
                        <select name="recoveryKind-{{row.idx}}" {{#unless @root.editable}}disabled{{/unless}}>
                            {{#each row.kindOptions}}
                            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                            {{/each}}
                        </select>
                        {{#if @root.editable}}
                        <a class="usage-icon-btn" data-action="recoveryRowDelete" data-row-index="{{row.idx}}"
                           title="削除"><i class="fas fa-times"></i></a>
                        {{/if}}
                    </div>
                    {{else}}
                    <p class="usage-empty-hint">（範囲なし）</p>
                    {{/each}}
                    {{#if editable}}
                    <a class="tnx-row-btn" data-action="recoveryRowAdd" title="範囲を追加"><i class="fas fa-plus"></i></a>
                    {{/if}}
                </div>
                <label class="usage-field-label">除外タグ</label>
                <div class="usage-skill-ref-list">
                    {{#each recoveryExcludeRows}}
                    <div class="usage-skill-ref-row">
                        <span class="usage-skill-ref-name">{{this.label}}</span>
                        {{#if ../editable}}
                        <a class="usage-icon-btn" data-action="recoveryExcludeDelete" data-key="{{this.key}}"
                           title="削除"><i class="fas fa-times"></i></a>
                        {{/if}}
                    </div>
                    {{else}}
                    <p class="usage-empty-hint">（なし）</p>
                    {{/each}}
                </div>
                {{#if editable}}
                <div class="usage-skill-ref-add">
                    <select class="recovery-exclude-select">
                        <option value="">── 除外するタグを選択 ──</option>
                        {{#each recoveryExcludeChoices}}
                        <option value="{{this.value}}">{{this.label}}</option>
                        {{/each}}
                    </select>
                </div>
                {{/if}}
                <div class="usage-form-row usage-toggle-row">
                    <label class="usage-toggle-inline">
                        <input type="checkbox" name="recoveryAll" {{checked usage.recoveryAll}}
                               {{#unless editable}}disabled{{/unless}}>
                        <span>該当すべてを回復</span>
                    </label>
                </div>
                {{#unless recoveryAll}}
                <div class="usage-form-row">
                    <label class="usage-field-label">回復数</label>
                    <div class="number-input-spinner">
                        <button type="button" data-action="decrementRecoveryCount" class="tnx-btn" {{#unless editable}}disabled{{/unless}}>-</button>
                        <input type="number" name="recoveryCount" value="{{recoveryCountValue}}" min="1"
                               {{#unless editable}}disabled{{/unless}}>
                        <button type="button" data-action="incrementRecoveryCount" class="tnx-btn" {{#unless editable}}disabled{{/unless}}>+</button>
                    </div>
                </div>
                {{/unless}}
                {{/if}}
            </fieldset>
            {{/if}}

            {{!-- 適用される効果（ActiveEffect） --}}
            <fieldset class="tnx-fieldset usage-effects-section">
                <legend>適用される効果</legend>
                <div class="usage-effect-list">
                    {{#each addedEffects}}
                    <div class="usage-skill-ref-row">
                        <span class="usage-skill-ref-name">{{this.name}}{{#if this.sourceName}} <small>（{{this.sourceName}}）</small>{{/if}}{{#if this.grantSelf}} <small>（自分に付与）</small>{{/if}}</span>
                        {{#if ../editable}}
                        <a class="usage-icon-btn" data-action="effectRemove" data-item-id="{{this.itemId}}" data-effect-id="{{this.effectId}}"
                           title="解除"><i class="fas fa-times"></i></a>
                        {{/if}}
                    </div>
                    {{else}}
                    <p class="usage-empty-hint">（適用される効果なし）</p>
                    {{/each}}
                </div>
                {{#if editable}}
                <div class="usage-skill-ref-add">
                    <select class="effect-select">
                        <option value="">── 追加する効果を選択 ──</option>
                        {{#each availableEffectGroups}}
                        <optgroup label="{{this.label}}">
                            {{#each this.options}}
                            <option value="{{this.value}}">{{this.name}}</option>
                            {{/each}}
                        </optgroup>
                        {{/each}}
                    </select>
                </div>
                {{#unless hasAnyEffect}}
                <p class="usage-empty-hint">（追加できる効果がありません）</p>
                {{/unless}}
                {{/if}}
            </fieldset>

        </div>
        {{/unless}}

    </section>
</div>
