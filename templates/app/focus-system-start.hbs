<section class="tnx-focus-system-sheet__body">

    <div class="fs-grid">
        <div class="form-group">
            <label>読み込み元</label>
            <select name="sourceUuid">
                <option value="">手動設定</option>
                {{#each sources}}
                    <option value="{{this.uuid}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
                {{/each}}
            </select>
        </div>
        <div class="form-group">
            <label>名称</label>
            <input type="text" name="name" value="{{name}}">
        </div>
    </div>

    {{> "systems/tokyo-nova-axleration/templates/parts/focus-system-editor.hbs"}}

    <footer class="fs-start-footer">
        <button type="submit" class="tnx-btn tnx-btn--primary">
            <i class="fas fa-play"></i> FS判定を開始
        </button>
    </footer>

</section>
