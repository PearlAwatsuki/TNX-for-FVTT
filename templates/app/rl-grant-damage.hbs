<div class="rl-request-body">

    {{!-- 読み込み元（アクトシートのプリセット・2026-07-21） --}}
    {{#if presetGroups.length}}
        <div class="form-group rl-form-group">
            <label class="rl-label">読み込み元</label>
            <select name="presetId" class="rl-select">
                <option value="">（手動設定）</option>
                {{#each presetGroups}}
                    <optgroup label="{{this.label}}">
                        {{#each this.presets}}
                            <option value="{{this.id}}">{{this.label}}</option>
                        {{/each}}
                    </optgroup>
                {{/each}}
            </select>
        </div>
    {{/if}}

    {{!-- 系統 --}}
    <div class="form-group rl-form-group">
        <label class="rl-label">系統</label>
        <select name="category" class="rl-select">
            {{#each CATEGORY_OPTIONS}}
                <option value="{{this.value}}">{{this.label}}</option>
            {{/each}}
        </select>
    </div>

    {{!-- ダメージの決め方（2026-07-24）。固定＝値をそのまま／カード＝命中確定後に通常のダメージ算出
          （攻撃力＝基準値＋カード）。どちらも命中確定後にカバー等の「算出直前」効果を挟める --}}
    <div class="form-group rl-form-group">
        <label class="rl-label">ダメージの決め方</label>
        <select name="mode" class="rl-select">
            {{#each DAMAGE_MODES}}
                <option value="{{this.value}}">{{this.label}}</option>
            {{/each}}
        </select>
    </div>

    {{!-- ダメージ＝種別＋値の1項目（攻撃力の設定と同じ split-fields）。
          種別は物理のみ（X＝対応防御力が無い＝防護点で軽減できないダメージ）。
          値のラベルはモードで切り替え（固定＝ダメージ／カード×物理＝基準値）。
          カード×精神/社会は攻撃力の概念が無い＝グループごと隠す（カードのみ算出） --}}
    <div class="form-group rl-form-group damage-fields-group">
        <label class="rl-label damage-value-label">ダメージ</label>
        <div class="form-fields split-fields">
            <select name="damageType" class="rl-select damage-type-field">
                {{#each DAMAGE_TYPES}}
                    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
            </select>
            <div class="number-input-spinner">
                <button type="button" class="tnx-btn" data-action="decrement" aria-label="減少">−</button>
                <input type="number" name="value" value="0" min="0" max="99">
                <button type="button" class="tnx-btn" data-action="increment" aria-label="増加">＋</button>
            </div>
        </div>
    </div>

    {{!-- 自由記述(軽減技能の可否などを伝える) --}}
    <div class="form-group rl-form-group">
        <label class="rl-label">記述</label>
        <textarea name="note" class="rl-textarea" rows="2" placeholder="（省略可）"></textarea>
    </div>

    {{> "systems/tokyo-nova-axleration/templates/parts/target-picker.hbs"}}

    <footer class="rl-form-footer">
        <button type="submit" class="tnx-btn tnx-btn--primary rl-submit-btn">
            <i class="fas fa-burst"></i> ダメージカードを出す
        </button>
    </footer>

</div>
