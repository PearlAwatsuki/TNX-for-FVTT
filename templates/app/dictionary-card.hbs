{{!-- 辞典カード(フェーズ16-2)。辞典ブラウザの種別別カードとアイテム・ツールチップの共用部品。
     データは dictionary-cards.mjs のビルダーが組み立てる(kind: outfit / styleSkill /
     generalSkill / style / miracle / organization)。ルルブのデータカード形式の踏襲
     (名前ヘッダ＋パラメータ行＋解説)だが、視覚意匠は TNX のデザイン言語で再解釈する。 --}}
<article class="tnx-dict-card tnx-dict-card--{{card.kind}}">
    <header class="tnx-dict-card__header">
        {{!-- アイコン+名前は不可分ブロック(2026-08-31 指摘=名前がどれだけ長くても
             アイコンは名前のすぐ左に付く。アイコンだけ別行へ折れてはいけない) --}}
        <div class="tnx-dict-card__identity">
            {{#if card.img}}<img class="tnx-dict-card__icon" src="{{card.img}}" alt="" loading="lazy">{{/if}}
            <div class="tnx-dict-card__titles">
                {{!-- ふりがなはルビ(名前と同色・名前幅に均等割り)。分類は名前の下に縦積み --}}
                <span class="tnx-dict-card__name">{{#if card.furigana}}<ruby>{{card.name}}<rt>{{card.furigana}}</rt></ruby>{{else}}{{card.name}}{{/if}}</span>
                {{#if card.nameEn}}<span class="tnx-dict-card__name-en">{{card.nameEn}}</span>{{/if}}
                {{#if card.subtitle}}<span class="tnx-dict-card__subtitle">{{card.subtitle}}</span>{{/if}}
            </div>
        </div>
        {{#each card.tags}}<span class="tnx-dict-card__tag">{{this}}</span>{{/each}}
    </header>
    {{#if card.rows.length}}
    <div class="tnx-dict-card__params">
        {{#each card.rows}}
        <div class="tnx-dict-card__param{{#if this.full}} tnx-dict-card__param--full{{/if}}{{#if this.third}} tnx-dict-card__param--third{{/if}}">
            <label>{{this.label}}：</label><span>{{this.value}}</span>
        </div>
        {{/each}}
    </div>
    {{/if}}
    {{#if card.description}}
    <div class="tnx-dict-card__desc">{{{card.description}}}</div>
    {{/if}}
    {{#if card.condition}}
    <div class="tnx-dict-card__condition"><label>条件</label><div class="tnx-dict-card__condition-body">{{{card.condition}}}</div></div>
    {{/if}}
    {{#if card.abilities}}
    <div class="tnx-dict-card__abilities">
        {{#each card.abilities}}
        <div class="tnx-dict-card__ability"><label>{{this.label}}</label><span>{{this.value}}／{{this.control}}</span></div>
        {{/each}}
    </div>
    {{/if}}
</article>
