<section class="{{cssClass}}">
    <header class="sheet-header">
        <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage" title="{{item.name}}"/>

        <div class="header-fields">
            <h1 class="charname-container">
                <input class="furigana-input" name="system.furigana" type="text" value="{{system.furigana}}" placeholder="フリガナ" />
                <input class="itemname-input" name="name" type="text" value="{{sourceName}}" placeholder="神業" />
            </h1>
        </div>
    </header>

    <nav class="sheet-tabs tabs" data-group="primary">
        <a class="item" data-action="tab" data-group="primary" data-tab="description">説明</a>
        <a class="item" data-action="tab" data-group="primary" data-tab="setting">設定</a>
        <a class="item" data-action="tab" data-group="primary" data-tab="usage">用途</a>
    </nav>

     <section class="sheet-body">
        <div class="tab description" data-group="primary" data-tab="description">
            <div class="tnx-editor-section">

              <div class="tnx-editor-section__header">
                    <label>説明</label>

                </div>
                <div class="tnx-editor-section__content">
                    {{editor enrichedDescription target="system.description" engine="prosemirror" button=true owner=owner editable=editable}}
                </div>
            </div>
            <div class="tnx-editor-section">
                <div class="tnx-editor-section__header">
                    <label>条件</label>
                </div>
                <div class="tnx-editor-section__content">
                    {{editor enrichedConditionDescription target="system.usageCondition" engine="prosemirror" button=true owner=owner editable=editable}}
                </div>
            </div>
        </div>

        <div class="tab setting" data-group="primary" data-tab="setting">
            <fieldset class="tnx-fieldset">
                <legend>使用回数</legend>
                {{!-- 使用回数は他アイテム(アウトフィット/スタイル技能)と同形の消費済み/最大値表示(2026-07-18 uses 一本化)。
                     母数(最大値)はスタイルレベル連動で維持される。数値入力はスピナー不使用の例外(他アイテムと同じ)。
                     「使用済み」チェックは廃止(2026-09-05)=残り使用回数と二重管理だった --}}
                <div class="tnx-form-field">
                    <div class="form-group usage-limit-group">
                        <label>使用回数</label>
                        <div class="usage-inputs">
                            <div class="usage-field">
                                <label>消費済み</label>
                                <input type="number" name="system.uses.spent" value="{{system.uses.spent}}">
                            </div>
                            <span class="usage-separator">/</span>
                            <div class="usage-field usage-field--formula">
                                <label>最大値</label>
                                <input type="text" name="system.uses.max" value="{{system.uses.max}}" placeholder="数値 または 式">
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>

            <fieldset class="tnx-fieldset">
                <legend>識別キー</legend>
                <div class="tnx-form-field">
                    <div class="form-group">
                        <label>識別キー</label>
                        <input type="text" name="system.identificationKey" value="{{system.identificationKey}}" placeholder="識別キーを入力"/>
                    </div>
                </div>
            </fieldset>


            {{!-- 効果の参照(17-5・アイテム側の機能)。《万能道具》《神意》は、取得した区分(〈フォルム〉〈属性〉)に
                 よって**効果と経験点の取得条件が指定の神業と同じになる**——その神業「として」使うのではない。
                 ここは**対応表**(辞典データ)で、どれになるかは**スタイルを設定したときに決まる**
                 (2026-09-06 ユーザー裁定)。区分と神業は1対1なのでドロップで結線する --}}
            <fieldset class="tnx-fieldset">
                <legend>
                    効果の参照
                    {{#if asOtherIsChoice}}{{#if editable}}
                    <a class="tnx-combo-add" data-action="asOtherChoiceAdd" title="行を追加"><i class="fas fa-plus"></i></a>
                    {{/if}}{{/if}}
                </legend>
                <div class="tnx-form-field">
                    <div class="form-group">
                        <label>選び方</label>
                        <select name="system.asOther.mode" {{#unless editable}}disabled{{/unless}}>
                            {{selectOptions asOtherModeOptions selected=system.asOther.mode}}
                        </select>
                    </div>
                    {{#if asOtherSelectedLabel}}
                    <div class="form-group">
                        <label>このキャラクターの効果</label>
                        <span>{{asOtherSelectedLabel}}</span>
                    </div>
                    {{/if}}
                </div>

                {{#if asOtherIsChoice}}
                <div class="tnx-asother-wrap">
                    <table class="tnx-asother-table">
                        <thead>
                            <tr>
                                <th class="aso-skill">区分（技能）</th>
                                <th class="aso-miracle">参照する神業</th>
                                {{#if editable}}<th class="aso-del"></th>{{/if}}
                            </tr>
                        </thead>
                        <tbody>
                            {{#each asOtherChoices as |row|}}
                            <tr {{#if row.selected}}class="aso-row--selected"{{/if}}>
                                <td class="aso-skill">
                                    {{#if row.skill}}
                                    <button type="button" class="tnx-linked-btn" data-action="asOtherSkillOpen" data-index="{{row.idx}}" data-context-menu-type="asother-skill">
                                        <img src="{{row.skill.img}}" class="tnx-linked-btn__icon"/>
                                        <span class="tnx-linked-btn__label">{{row.skill.name}}</span>
                                    </button>
                                    {{else}}
                                    <div class="tnx-import-box tnx-import-box--inline" data-drop-area="asotherSkill-{{row.idx}}">
                                        <span>技能をドロップ</span>
                                    </div>
                                    {{/if}}
                                </td>
                                <td class="aso-miracle">
                                    {{#if row.miracle}}
                                    <button type="button" class="tnx-linked-btn" data-action="asOtherChoiceOpen" data-index="{{row.idx}}" data-context-menu-type="asother-choice">
                                        <img src="{{row.miracle.img}}" class="tnx-linked-btn__icon"/>
                                        <span class="tnx-linked-btn__label">{{row.miracle.name}}</span>
                                    </button>
                                    {{else}}
                                    <div class="tnx-import-box tnx-import-box--inline" data-drop-area="asotherMiracle-{{row.idx}}">
                                        <span>神業をドロップ</span>
                                    </div>
                                    {{/if}}
                                </td>
                                {{#if @root.editable}}
                                <td class="aso-del">
                                    <a class="tnx-combo-del" data-action="asOtherChoiceDelete" data-index="{{row.idx}}" title="削除"><i class="fas fa-trash"></i></a>
                                </td>
                                {{/if}}
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
                {{/if}}
            </fieldset>

        </div>

        <div class="tab usage" data-group="primary" data-tab="usage">
            {{> "systems/tokyo-nova-axleration/templates/parts/usage-list.hbs"}}
        </div>



    </section>
</section>