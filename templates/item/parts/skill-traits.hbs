{{!-- 技能の特性(2026-07-09): 散在していた真偽フラグを1セクションに集約(アウトフィットの「特性」に倣う)。
     フラグがオンのとき各詳細セクションが表示される。ラベルが長いフラグ(wide)は1行を占有する。
     旧「役割」(skillRoles)は廃止(2026-07-17 再編)——資格・候補の判定は用途タイプの所持のみ。 --}}
<fieldset class="tnx-fieldset">
    <legend>特性</legend>
    <div class="skill-traits-flags">
        {{#each traitFlags}}
        <label class="outfit-flag{{#if this.wide}} outfit-flag--wide{{/if}}">
            <input type="checkbox" name="{{this.name}}" {{#if this.checked}}checked{{/if}} {{#if this.disabled}}disabled{{/if}}>
            <span>{{this.label}}</span>
        </label>
        {{/each}}
    </div>
</fieldset>
