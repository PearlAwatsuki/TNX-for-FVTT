<div class="tnx-hud">
    <div class="hud-container hud-right-column{{#if rightCollapsed}} collapsed{{/if}}">
        <button class="hud-collapse-toggle hud-collapse-right" data-action="toggleHudColumn" data-column="right" title="右カラムを折りたたむ">
            <i class="fas fa-chevron-right"></i>
        </button>
        <div class="main-area neuro-area">
            <span class="card-slot-label">シーンカード</span>
            <div class="neuro-cards-row">
                <div class="card-slot">
                    {{#if (and neuroDeck neuroDeck.count)}}
                        <div class="deck-card" data-action="drawNeuro" title="ニューロデッキ (クリックでシーンカードを引く)" draggable="true" data-drag-type="neuro-deck">
                            <img src="{{neuroDeck.img}}" alt="ニューロデッキ">
                            <span class="deck-count">{{neuroDeck.count}}</span>
                        </div>
                    {{else}}
                        <div class="card-empty-placeholder">
                            <i class="fas fa-inbox"></i>
                        </div>
                    {{/if}}
                </div>

                <div class="card-slot">
                    {{#if (and scenePile scenePile.cards.size)}}
                        {{!-- カード画像しか見えないので、ホバーでチャットカードと同じ意匠の
                              ツールチップを出す(2026-08-16・data-tooltip-html) --}}
                        <div class="deck-card scene-card-display" data-drop-zone="scene" data-tooltip-html="{{sceneCardTooltip}}" data-tooltip-class="tnx-neuro-card-tooltip">
                            <img src="{{topSceneCard.img}}" alt="{{topSceneCard.name}}">
                        </div>
                    {{else}}
                        <div class="card-empty-placeholder" data-drop-zone="scene">
                            <i class="fas fa-cards-blank"></i>
                        </div>
                    {{/if}}
                </div>
            </div>
        </div>

        <div class="hud-panel hud-insert-area">
            <span class="card-slot-label">情報項目</span>
            {{!-- 情報収集判定(14-9)。点線枠は実要素の受け皿(2026-08-17 是正=旧 ::after の
                  擬似要素は子を持てず、項目が枠の外に並んでいた)。項目は装飾プレート
                  (2026-08-17 ユーザー指示): 非公開=施錠風・公開=アクセント枠・目標値チップは
                  開示が進むと埋まる。ツールチップ常設・判定ボタンは項目に1つ --}}
            <div class="hud-info-frame">
                {{#each infoItems as |info|}}
                    <div class="hud-info-item {{#if info.masked}}is-masked{{/if}}{{#if info.hiddenMark}} is-hidden{{/if}}"
                         {{#if info.tooltipHtml}}data-tooltip-html="{{info.tooltipHtml}}" data-tooltip-class="tnx-info-card-tooltip"{{/if}}>
                        <div class="hud-info-head">
                            {{#if info.hiddenMark}}<i class="fas fa-lock hud-info-lock"></i>{{/if}}
                            <span class="hud-info-title">{{info.title}}</span>
                            {{#if info.canCheck}}
                                <a class="tnx-icon-ctrl hud-info-check" data-action="infoCheck" data-item-id="{{info.id}}" title="情報収集判定"><i class="fas fa-magnifying-glass"></i></a>
                            {{/if}}
                        </div>
                        {{#if info.tns.length}}
                            <div class="hud-info-tns">
                                {{#each info.tns as |chip|}}
                                    <span class="hud-info-tn {{#if chip.disclosed}}is-open{{/if}}">{{chip.tn}}</span>
                                {{/each}}
                            </div>
                        {{/if}}
                    </div>
                {{/each}}
            </div>
        </div>

        <div class="main-area">
            <div class="card-slot">
                <span class="card-slot-label">山札</span>
                {{#if (and cardDeck cardDeck.count)}}
                    <div class="deck-card deck-area" data-action="drawFromDeck" title="山札からドロー" draggable="true" data-drag-type="deck" data-drop-zone="deck">
                        <img src="{{cardDeck.img}}" alt="山札">
                        <span class="deck-count">{{cardDeck.count}}</span>
                    </div>
                {{else}}
                    <div class="card-empty-placeholder deck-area" data-drop-zone="deck">
                        <i class="fas fa-inbox"></i>
                    </div>
                {{/if}}
            </div>

            <div class="card-slot">
                <span class="card-slot-label">捨て札</span>
                {{#if (and discardPile discardPile.cards.size)}}
                    <div class="deck-card discard-area" data-action="takeFromDiscard" title="{{discardPile.name}}" draggable="true" data-drag-type="discard-card" data-drop-zone="discard">
                        <img src="{{topDiscardImage}}" alt="捨て札">
                        <span class="deck-count">{{discardPile.cards.size}}</span>
                    </div>
                {{else}}
                    <div class="card-empty-placeholder discard-area" data-drop-zone="discard">
                        <i class="fas fa-trash"></i>
                    </div>
                {{/if}}
            </div>
        </div>
    </div>

    <div class="hud-container hud-bottom-bar{{#if bottomCollapsed}} collapsed{{/if}}">
        <div class="hud-bottom-panels">
            {{!-- 参加者パネル: 自分以外の参加者のステータス+手札を常時表示する。
                  行はカードのドロップ先(ドラッグしたカードをそのユーザーに渡す)。
                  裏向きのカードには名前を一切出さない(title なし=内容漏れ防止) --}}
            <div class="participants-area hud-panel{{#if participantsCollapsed}} collapsed{{/if}}">
                <div class="participants-header" data-action="toggleParticipantsArea" title="参加者の表示を開閉">
                    <i class="fas fa-chevron-down participants-fold-icon"></i>
                    <span class="card-slot-label">参加者</span>
                </div>
                <div class="participants-list">
                    {{#each participants as |p|}}
                        <div class="participant-row" data-drop-zone="participant" data-user-id="{{p.userId}}">
                            <span class="participant-name" style="color: {{p.color}}">{{p.userName}}</span>
                            <div class="participant-main">
                                {{!-- ステータス列は常設。登場三態(シーンプレイヤー/登場中/舞台裏)で
                                      基本埋まるが、万一空でも空とわかる器を置く --}}
                                <div class="participant-status">
                                    {{#if p.isRL}}
                                        <div class="participant-rl-plate">RL</div>
                                    {{else}}
                                        {{#each p.statusCards as |sc|}}
                                            {{#if sc.plate}}
                                                <div class="participant-status-plate" title="{{sc.label}}">
                                                    <span class="status-plate-en">{{sc.plate.en}}</span>
                                                    <span class="status-plate-ja">{{sc.plate.ja}}</span>
                                                </div>
                                            {{else}}
                                                <div class="participant-status-card" title="{{sc.label}}">
                                                    <img src="{{sc.img}}" alt="{{sc.label}}">
                                                </div>
                                            {{/if}}
                                        {{else}}
                                            <div class="participant-status-empty" title="ステータスなし"></div>
                                        {{/each}}
                                    {{/if}}
                                </div>
                                <div class="participant-cards">
                                    {{#if p.cards.length}}
                                        {{#each p.cards as |card|}}
                                            {{#if card.faceUp}}
                                                <img class="participant-card-img" src="{{card.img}}" alt="{{card.name}}" title="{{card.name}}">
                                            {{else}}
                                                <img class="participant-card-img" src="{{card.img}}" alt="裏向きのカード">
                                            {{/if}}
                                        {{/each}}
                                    {{else}}
                                        <span class="participant-empty">（手札なし）</span>
                                    {{/if}}
                                </div>
                            </div>
                        </div>
                    {{else}}
                        <span class="participant-empty">（参加者なし）</span>
                    {{/each}}
                </div>
            </div>

            {{#if accessCards}}
            <div class="access-area hud-panel{{#if accessCollapsed}} collapsed{{/if}}">
                <div class="access-area-header" data-action="toggleAccessArea" title="アクセスカードの表示を開閉">
                    <i class="fas fa-chevron-down access-fold-icon"></i>
                    <span class="card-slot-label">アクセスカード</span>
                </div>
                <div class="access-cards-row">
                    {{#each accessCards as |card|}}
                        <div class="access-card" data-action="presentAccessCard" data-card-id="{{card.id}}" title="{{card.name}} (クリックで全員に提示)">
                            <img src="{{card.img}}" alt="{{card.name}}">
                        </div>
                    {{/each}}
                </div>
            </div>
            {{/if}}
        </div>

        <div class="hud-bottom-main">
            {{#if statusCards.length}}
            <div class="status-card-area hud-panel">
                <span class="card-slot-label">ステータス</span>
                <div class="status-cards-row">
                    {{#each statusCards as |card|}}
                        {{#if card.plate}}
                            <div class="status-plate" title="{{card.label}}">
                                <span class="status-plate-en">{{card.plate.en}}</span>
                                <span class="status-plate-ja">{{card.plate.ja}}</span>
                            </div>
                        {{else}}
                            <div class="status-card" title="{{card.label}}">
                                <img src="{{card.img}}" alt="{{card.label}}">
                            </div>
                        {{/if}}
                    {{/each}}
                </div>
            </div>
            {{/if}}

            <div class="hud-bottom-content">
                <div class="hand-area hud-panel {{#if checkPending}}check-pending{{/if}} {{#if checkTrumpMode}}trump-mode{{/if}}" data-drop-zone="hand">
                    <span class="card-slot-label">手札</span>
                    <div class="hand-cards-row">
                        {{#if (and hand hand.cards.size)}}
                            {{#each handCards as |card|}}
                                <div class="card-hand-slot {{#if card.checkValid}}check-valid{{/if}}">
                                    <div class="card-in-hand {{#if card.checkValid}}check-valid{{/if}} {{#if card.isJoker}}is-joker{{/if}}"
                                         data-action="playCard"
                                         data-card-id="{{card.id}}"
                                         data-suit="{{card.suit}}"
                                         title="{{card.name}}"
                                         draggable="true"
                                         data-drag-type="hand-card">
                                        <img src="{{card.img}}" alt="{{card.name}}">
                                        <span class="card-preview-label">{{card.preview}}</span>
                                    </div>
                                </div>
                            {{/each}}
                        {{else}}
                            <div class="card-empty-placeholder card-empty-clickable" data-action="replenishHand" title="手札（クリックで補充）">
                                <i class="fas fa-hand-paper"></i>
                            </div>
                        {{/if}}
                    </div>
                </div>
            </div>

            <div class="trump-area hud-panel">
                <div class="card-slot">
                    <span class="card-slot-label">切り札</span>
                    {{#if trumpCard}}
                        <div class="card-in-hand" data-action="useTrump" data-card-id="{{trumpCard.id}}" title="{{trumpCard.name}} (クリックで使用)" draggable="true" data-drag-type="trump-card">
                            <img src="{{trumpCard.img}}" alt="{{trumpCard.name}}">
                        </div>
                    {{else}}
                        {{#if isGM}}
                        <div class="card-empty-placeholder card-empty-clickable" data-action="resetRlTrump" title="切り札（クリックで再配布）">
                            <i class="fas fa-star"></i>
                        </div>
                        {{else}}
                        <div class="card-empty-placeholder" title="切り札">
                            <i class="fas fa-star"></i>
                        </div>
                        {{/if}}
                    {{/if}}
                </div>
            </div>

            <button class="hud-collapse-toggle hud-collapse-bottom" data-action="toggleHudColumn" data-column="bottom" title="HUD / ホットバーを切り替え">
                <i class="fas fa-chevron-left"></i>
            </button>
        </div>
    </div>
</div>
