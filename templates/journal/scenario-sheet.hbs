<section class="scenario-sheet two-column-layout">
    <nav class="sheet-tabs vertical-tabs scenario-sidebar" data-group="primary">
        <a class="item" data-action="tab" data-tab="setting" data-group="primary">
            <i class="fas fa-cogs"></i>
            <span>設定</span>
        </a>
        <a class="item" data-action="tab" data-tab="scenario-info" data-group="primary">
            <i class="fas fa-scroll"></i>
            <span>シナリオ情報</span>
        </a>
        <a class="item" data-action="tab" data-tab="scenes" data-group="primary">
            <i class="fas fa-film"></i>
            <span>シーン</span>
        </a>
        <a class="item" data-action="tab" data-tab="texts" data-group="primary">
            <i class="fas fa-paragraph"></i>
            <span>テキスト</span>
        </a>
        <a class="item" data-action="tab" data-tab="info" data-group="primary">
            <i class="fas fa-info-circle"></i>
            <span>情報項目</span>
        </a>
        <a class="item" data-action="tab" data-tab="requests" data-group="primary">
            <i class="fas fa-clipboard-list"></i>
            <span>RL プリセット</span>
        </a>
    </nav>

    <section class="sheet-body">
        <div class="tab setting" data-group="primary" data-tab="setting">
            <div class="scenario-content">
                <div class="setup-controls">
                    <button type="button" class="tnx-btn" data-action="launchWizard">
                        <i class="fas fa-magic"></i> セットアップウィザードを起動
                    </button>
                </div>
                <fieldset class="tnx-fieldset">
                    <legend>関連カード設定</legend>
                    <div class="card-management-grid">
                        <div class="card-slot" data-drop-area="cardDeck">
                            <h3 class="slot-header">山札 (トランプ)</h3>
                            <div class="slot-body">
                                {{#if cardDeck}}
                                    <button type="button" class="tnx-linked-btn" data-action="openDocument" data-uuid="{{cardDeck.uuid}}">
                                        <img src="{{cardDeck.img}}" class="tnx-linked-btn__icon"/>
                                        <span class="tnx-linked-btn__label">{{cardDeck.name}}</span>
                                    </button>
                                {{else}}
                                    <div class="tnx-import-box tnx-import-box--dropzone" data-drop-area="cardDeck">
                                        <span>山札(Deck)をドロップ</span>
                                    </div>
                                {{/if}}
                            </div>
                        </div>
                        <div class="card-slot" data-drop-area="discardPile">
                            <h3 class="slot-header">捨て札</h3>
                            <div class="slot-body">
                                {{#if discardPile}}
                                    <button type="button" class="tnx-linked-btn" data-action="openDocument" data-uuid="{{discardPile.uuid}}">
                                        <img src="{{discardPile.img}}" class="tnx-linked-btn__icon"/>
                                        <span class="tnx-linked-btn__label">{{discardPile.name}}</span>
                                    </button>
                                {{else}}
                                    <div class="tnx-import-box tnx-import-box--dropzone" data-drop-area="discardPile">
                                        <span>捨て札(Pile)をドロップ</span>
                                    </div>
                                {{/if}}
                            </div>
                        </div>
                        <div class="card-slot" data-drop-area="neuroDeck">
                            <h3 class="slot-header">ニューロデッキ</h3>
                            <div class="slot-body">
                                {{#if neuroDeck}}
                                    <button type="button" class="tnx-linked-btn" data-action="openDocument" data-uuid="{{neuroDeck.uuid}}">
                                        <img src="{{neuroDeck.img}}" class="tnx-linked-btn__icon"/>
                                        <span class="tnx-linked-btn__label">{{neuroDeck.name}}</span>
                                    </button>
                                {{else}}
                                    <div class="tnx-import-box tnx-import-box--dropzone" data-drop-area="neuroDeck">
                                        <span>山札(Deck)をドロップ</span>
                                    </div>
                                {{/if}}
                            </div>
                        </div>
                        <div class="card-slot" data-drop-area="scenePile">
                            <h3 class="slot-header">シーンカード</h3>
                            <div class="slot-body">
                                {{#if scenePile}}
                                    <button type="button" class="tnx-linked-btn" data-action="openDocument" data-uuid="{{scenePile.uuid}}">
                                        <img src="{{scenePile.img}}" class="tnx-linked-btn__icon"/>
                                        <span class="tnx-linked-btn__label">{{scenePile.name}}</span>
                                    </button>
                                {{else}}
                                    <div class="tnx-import-box tnx-import-box--dropzone" data-drop-area="scenePile">
                                        <span>捨て札(Pile)をドロップ</span>
                                    </div>
                                {{/if}}
                            </div>
                        </div>
                        <div class="card-slot" data-drop-area="accessCardPile">
                            <h3 class="slot-header">アクセスカード置き場</h3>
                            <div class="slot-body">
                                {{#if accessCardPile}}
                                    <button type="button" class="tnx-linked-btn" data-action="openDocument" data-uuid="{{accessCardPile.uuid}}">
                                        <img src="{{accessCardPile.img}}" class="tnx-linked-btn__icon"/>
                                        <span class="tnx-linked-btn__label">{{accessCardPile.name}}</span>
                                    </button>
                                {{else}}
                                    <div class="tnx-import-box tnx-import-box--dropzone" data-drop-area="accessCardPile">
                                        <span>手札(hand)をドロップ</span>
                                    </div>
                                {{/if}}
                            </div>
                        </div>
                        <div class="card-slot" data-drop-area="gmTrumpDiscard">
                            <h3 class="slot-header">RL切り札捨て場</h3>
                            <div class="slot-body">
                                {{#if gmTrumpDiscard}}
                                    <button type="button" class="tnx-linked-btn" data-action="openDocument" data-uuid="{{gmTrumpDiscard.uuid}}">
                                        <img src="{{gmTrumpDiscard.img}}" class="tnx-linked-btn__icon"/>
                                        <span class="tnx-linked-btn__label">{{gmTrumpDiscard.name}}</span>
                                    </button>
                                {{else}}
                                    <div class="tnx-import-box tnx-import-box--dropzone" data-drop-area="gmTrumpDiscard">
                                        <span>捨て札(Pile)をドロップ</span>
                                    </div>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                </fieldset>
                <fieldset class="tnx-fieldset">
                    <legend>管理アクション</legend>
                    <div class="scenario-actions">
                        <div>
                            <button type="button" class="tnx-btn" data-action="createAllUserHands">
                                <i class="fas fa-users"></i> 全ユーザーの手札・切り札を作成
                            </button>
                        </div>
                        <div>
                            <button type="button" class="tnx-btn" data-action="dealTrumpForRl">
                                <i class="fas fa-crown"></i> RLの切り札を設定
                            </button>
                        </div>
                        <div>
                            <button type="button" class="tnx-btn" data-action="resetAccessCards">
                                <i class="fas fa-undo"></i> アクセスカードをリセットする
                            </button>
                        </div>
                        <div>
                            <button type="button" class="tnx-btn" data-action="dealInitialHands">
                                <i class="fas fa-hand-holding"></i> 初期手札を配布
                            </button>
                        </div>
                        <div>                            
                            <button type="button" class="tnx-btn" data-action="dealTrumpFromNeuro">
                                <i class="fas fa-star"></i> 切り札を配布
                            </button>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>

        <div class="tab scenario-info" data-group="primary" data-tab="scenario-info">
            <div class="scenario-info-container">
                <div class="trailer-section">
                    <div class="tnx-section-header">
                        <h3>トレーラー</h3>
                        <button type="button" class="tnx-btn tnx-btn--sm" data-action="sendTrailerToChat">
                            <i class="fas fa-paper-plane"></i> チャットに送信
                        </button>
                    </div>
                    <textarea name="trailer" class="trailer-textarea" rows="8" placeholder="シナリオのトレーラーをここに入力...">{{trailer}}</textarea>
                </div>
                <div class="handouts-section">
                    <div class="tnx-section-header">
                        <h3>ハンドアウト</h3>
                        <button type="button" class="tnx-ring-btn" data-action="addHandout" title="ハンドアウトを追加">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                    <div class="handout-list">
                        {{#each handouts as |handout|}}
                        <div class="handout-item" data-id="{{handout.id}}">
                            <div class="handout-row handout-row--header">
                                <select name="actorId" class="handout-cast">
                                    <option value="">- キャスト未設定 -</option>
                                    {{#each ../castActors as |actor|}}
                                        <option value="{{actor.id}}" {{#if (eq actor.id ../handout.actorId)}}selected{{/if}}>{{actor.name}}</option>
                                    {{/each}}
                                </select>
                                <input type="text" name="pcName" class="handout-pc-name" value="{{handout.pcName}}" placeholder="PC名">
                                <input type="text" name="title" class="handout-title" value="{{handout.title}}" placeholder="ハンドアウトのタイトル">
                                <div class="tnx-ctrl-strip">
                                    <a class="tnx-icon-ctrl" data-action="sendHandoutToChat" title="チャットに送信"><i class="fas fa-paper-plane"></i></a>
                                    <a class="tnx-icon-ctrl" data-action="deleteHandout" title="削除"><i class="fas fa-trash"></i></a>
                                </div>
                            </div>
                            <div class="handout-row handout-row--recommendations">
                                <div class="recommendation-field">
                                    <label>コネ</label>
                                    <input type="text" name="connections" value="{{handout.connections}}">
                                </div>
                                <div class="recommendation-field">
                                    <label>推奨スート</label>
                                    <input type="text" name="recommendedSuit" value="{{handout.recommendedSuit}}">
                                </div>
                                <div class="recommendation-field">
                                    <label>推奨スタイル</label>
                                    <input type="text" name="recommendedStyle" value="{{handout.recommendedStyle}}">
                                </div>
                            </div>
                            <div class="handout-row handout-row--content-label">
                                <label>ハンドアウト内容</label>
                            </div>
                            <div class="handout-row handout-row--content-area">
                                <textarea name="content" rows="6" placeholder="ハンドアウトの内容を入力...">{{handout.content}}</textarea>
                            </div>
                            <div class="handout-row handout-row--ps">
                                <label>PS</label>
                                <input type="text" name="ps" value="{{handout.ps}}" placeholder="このハンドアウトの目的などを記載...">
                            </div>
                        </div>
                        {{/each}}
                    </div>
                </div>
            </div>
        </div>

        <div class="tab scenes" data-group="primary" data-tab="scenes">
            <div class="scenes-container">
                {{#each scenes as |phaseScenes phaseKey|}}
                <div class="phase-section">
                    <div class="tnx-section-header">
                        <h3>{{lookup ../phaseLabels phaseKey}}</h3>
                    </div>
                    <div class="scene-table">
                        <div class="scene-table-header">
                            <div class="header-cell scene-number">No.</div>
                            <div class="header-cell scene-name">シーン名</div>
                            <div class="header-cell scene-player">シーンプレイヤー</div>
                            <div class="header-cell scene-area">エリア</div>
                            <div class="header-cell scene-stage">舞台</div>
                            <div class="header-cell master-scene">MS</div>
                            <div class="header-cell scene-switch">切替</div>
                            <div class="header-cell scene-controls">
                                <button type="button" class="tnx-ring-btn" data-action="addScene" data-phase="{{phaseKey}}" title="このフェイズにシーンを追加">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                        </div>
                        <div class="scene-table-body">
                            {{#each phaseScenes as |scene index|}}
                                <div class="scene-item" data-scene-id="{{scene.id}}" data-phase="{{phaseKey}}">
                                    <div class="scene-main-row">
                                        <div class="table-cell scene-number">
                                            <input type="text" name="number" value="{{scene.number}}"/>
                                        </div>
                                        <div class="table-cell scene-name">
                                            <input type="text" name="name" value="{{scene.name}}"/>
                                        </div>
                                        <div class="table-cell scene-player">
                                            <select name="playerUserId">
                                                <option value="">{{#if scene.player}}旧: {{scene.player}}{{else}}- 未選択 -{{/if}}</option>
                                                {{#each ../../scenePlayerUsers as |user|}}
                                                    <option value="{{user.id}}" {{#if (eq user.id ../scene.playerUserId)}}selected{{/if}}>
                                                        {{user.name}}
                                                    </option>
                                                {{/each}}
                                            </select>
                                        </div>
                                        <div class="table-cell scene-area">
                                            <select name="area">
                                                {{#each ../../sceneAreaOptions as |opt|}}
                                                    <option value="{{opt.value}}" {{#if (eq opt.value ../scene.area)}}selected{{/if}}>{{opt.label}}</option>
                                                {{/each}}
                                            </select>
                                        </div>
                                        <div class="table-cell scene-stage">
                                            <select name="stage">
                                                <option value="">- 舞台なし -</option>
                                                {{#each ../../stageOptions as |opt|}}
                                                    <option value="{{opt.value}}" {{#if (eq opt.value ../scene.stage)}}selected{{/if}}>{{opt.label}}</option>
                                                {{/each}}
                                            </select>
                                        </div>
                                        <div class="table-cell master-scene">
                                            <input type="checkbox" name="isMasterScene" {{checked scene.isMasterScene}}/>
                                        </div>
                                        <div class="table-cell scene-switch">
                                            <a class="tnx-icon-ctrl" data-action="switchScene" title="このシーンに切り替え"><i class="fas fa-play-circle"></i></a>
                                        </div>
                                        <div class="table-cell scene-controls">
                                            <a class="tnx-icon-ctrl" data-action="deleteScene" title="このシーンを削除"><i class="fas fa-trash"></i></a>
                                        </div>
                                    </div>
                                    <details class="scene-details-row">
                                        <summary>切り替えメッセージ</summary>
                                        <div class="message-preview">
                                            <textarea name="switchMessage" rows="3" placeholder="シーン切り替え時にチャットに投稿されるメッセージを入力...">{{scene.switchMessage}}</textarea>
                                        </div>
                                    </details>
                                </div>
                            {{/each}}
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

        <div class="tab texts" data-group="primary" data-tab="texts">
            <div class="texts-container">
                <div class="tnx-section-header">
                    <h3>シナリオテキスト</h3>
                    <button type="button" class="tnx-btn tnx-btn--sm" data-action="addTextItem" title="テキスト項目を追加">
                        <i class="fas fa-plus"></i> テキストを追加
                    </button>
                </div>
                <div class="text-item-list">
                    {{#each scenarioTexts as |textItem|}}
                        <div class="text-item" data-id="{{textItem.id}}">
                            <div class="tnx-item-header tnx-item-header--card">
                                <input type="text" name="title" value="{{textItem.title}}" placeholder="テキストのタイトル"/>
                                <div class="tnx-ctrl-strip">
                                    <a class="tnx-icon-ctrl" data-action="sendTextToChat" title="チャットに送信"><i class="fas fa-paper-plane"></i></a>
                                    <a class="tnx-icon-ctrl" data-action="deleteTextItem" title="この項目を削除"><i class="fas fa-trash"></i></a>
                                </div>
                            </div>
                            <div class="text-item-body">
                                <textarea name="content" rows="5" placeholder="チャットに送信するテキストを入力...">{{textItem.content}}</textarea>
                            </div>
                        </div>
                    {{else}}
                        <div class="no-items-placeholder">
                            <p>テキスト項目がありません。「テキストを追加」ボタンから作成してください。</p>
                        </div>
                    {{/each}}
                </div>
            </div>
        </div>

        <div class="tab info" data-group="primary" data-tab="info">
            <div class="info-container">
                <div class="tnx-section-header">
                    <h3>情報項目</h3>
                    <button type="button" class="tnx-btn tnx-btn--sm" data-action="addInfoItem" title="情報項目を追加">
                        <i class="fas fa-plus"></i> 情報を追加
                    </button>
                </div>
                <div class="info-item-list">
                    {{#each infoItems as |infoItem|}}
                        <div class="info-item" data-id="{{infoItem.id}}">
                            <div class="tnx-item-header tnx-item-header--card">
                                <input type="text" name="title" value="{{infoItem.title}}" placeholder="情報名" data-info-id="{{infoItem.id}}"/>
                                <div class="tnx-ctrl-strip">
                                    <label class="disclosure-toggle">
                                        <input type="checkbox" name="isPublic" {{checked infoItem.isPublic}} title="{{#if infoItem.isPublic}}公開中 (クリックで非公開に){{else}}非公開 (クリックで公開){{/if}}" data-info-id="{{infoItem.id}}">
                                        <i class="fas {{#if infoItem.isPublic}}fa-lock-open{{else}}fa-lock{{/if}}"></i>
                                    </label>
                                    <a class="tnx-icon-ctrl" data-action="sendInfoToChat" data-info-id="{{infoItem.id}}" title="公開済みの情報をチャットに送信" {{#unless infoItem.isPublic}}disabled{{/unless}}>
                                        <i class="fas fa-paper-plane"></i>
                                    </a>
                                    <a class="tnx-icon-ctrl" data-action="deleteInfoItem" data-info-id="{{infoItem.id}}" title="この項目を削除"><i class="fas fa-trash"></i></a>
                                </div>
                            </div>
                            <div class="info-item-body">
                                <div class="info-contents-list">
                                    {{#each infoItem.contents as |contentItem|}}
                                        <div class="info-content-block {{#if contentItem.isDisclosed}}disclosed{{/if}}" data-content-id="{{contentItem.id}}">
                                            <div class="content-header">
                                                <h4>情報の内容</h4>
                                                <div class="tnx-ctrl-strip">
                                                    <label class="disclosure-toggle">
                                                        <input type="checkbox" name="isDisclosed" {{checked contentItem.isDisclosed}} title="{{#if contentItem.isDisclosed}}調査済み (クリックで未調査に){{else}}未調査 (クリックで調査済みに){{/if}}" data-info-id="{{infoItem.id}}" data-content-id="{{contentItem.id}}">
                                                        <i class="fas {{#if contentItem.isDisclosed}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
                                                    </label>
                                                    <a class="tnx-icon-ctrl" data-action="deleteInfoContent" data-info-id="{{infoItem.id}}" data-content-id="{{contentItem.id}}" title="この情報内容を削除"><i class="fas fa-trash"></i></a>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="skill-checks-area">
                                            <div class="tnx-item-header">
                                                <h5>使用技能</h5>
                                                <a class="tnx-ring-btn" data-action="addSkillCheck" data-info-id="{{infoItem.id}}" data-content-id="{{contentItem.id}}" title="使用技能を追加"><i class="fas fa-plus"></i></a>
                                            </div>
                                            <div class="skill-check-list">
                                                {{#each contentItem.skills as |skillItem|}}
                                                <div class="skill-check-row" data-skill-id="{{skillItem.id}}">
                                                    <input type="text" name="name" class="skill-name" placeholder="技能名" value="{{skillItem.name}}" data-info-id="{{infoItem.id}}" data-content-id="{{contentItem.id}}" data-skill-id="{{skillItem.id}}">
                                                    <span class="tn-label">目標値:</span>
                                                    <input type="number" name="tn" class="skill-tn" placeholder="-" value="{{skillItem.tn}}" data-info-id="{{infoItem.id}}" data-content-id="{{contentItem.id}}" data-skill-id="{{skillItem.id}}">
                                                    <a class="tnx-ring-btn" data-action="startInfoSkillCheck" title="判定を起動"><i class="fas fa-diamond"></i></a>
                                                    <a class="tnx-ring-btn" data-action="deleteSkillCheck" data-info-id="{{infoItem.id}}" data-content-id="{{contentItem.id}}" data-skill-id="{{skillItem.id}}" title="この技能を削除"><i class="fas fa-times"></i></a>
                                                </div>
                                                {{/each}}
                                            </div>
                                        </div>
                                        <textarea name="text" rows="4" placeholder="情報の内容（プレイヤーに公開されるテキスト）を入力..." data-info-id="{{infoItem.id}}" data-content-id="{{contentItem.id}}">{{contentItem.text}}</textarea>
                                    {{/each}}
                                </div>
                            </div>
                            <div class="add-content-button-wrapper">
                                <button type="button" class="tnx-btn tnx-btn-dashed" data-action="addInfoContent" data-info-id="{{infoItem.id}}">
                                    <i class="fas fa-plus"></i> 情報の内容を追加
                                </button>
                            </div>
                        </div>
                    {{else}}
                        <div class="no-items-placeholder">
                            <p>情報項目がありません。「情報を追加」ボタンから作成してください。</p>
                        </div>
                    {{/each}}
                </div>
            </div>
        </div>

        <div class="tab requests" data-group="primary" data-tab="requests">
            <div class="request-preset-container">

                <div class="tnx-section-header">
                    <h3>判定要求</h3>
                    <button type="button" class="tnx-btn tnx-btn--sm" data-action="addCheckRequestPreset">
                        <i class="fas fa-plus"></i> 判定要求を追加
                    </button>
                </div>
                <div class="preset-list">
                    {{#each checkRequestPresets}}
                        <div class="preset-item" data-preset-id="{{this.id}}">
                            <div class="tnx-item-header tnx-item-header--card">
                                <input type="text" name="label" value="{{this.label}}" placeholder="{{this.placeholder}}"
                                       data-preset-kind="checkRequests" data-preset-id="{{this.id}}">
                                <div class="tnx-ctrl-strip">
                                    <a class="tnx-icon-ctrl" data-action="presetUp"   data-preset-kind="checkRequests" data-preset-id="{{this.id}}" title="上へ"><i class="fas fa-chevron-up"></i></a>
                                    <a class="tnx-icon-ctrl" data-action="presetDown" data-preset-kind="checkRequests" data-preset-id="{{this.id}}" title="下へ"><i class="fas fa-chevron-down"></i></a>
                                    <a class="tnx-icon-ctrl" data-action="deletePreset" data-preset-kind="checkRequests" data-preset-id="{{this.id}}" title="削除"><i class="fas fa-trash"></i></a>
                                </div>
                            </div>
                            <div class="preset-body">
                                <div class="form-group">
                                    <label>判定種別</label>
                                    <select name="checkType" data-preset-kind="checkRequests" data-preset-id="{{this.id}}">
                                        {{#each this.checkTypes}}
                                            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                                        {{/each}}
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>技能</label>
                                    <select name="identificationKey" data-preset-kind="checkRequests" data-preset-id="{{this.id}}">
                                        <option value="">（その他・自由入力）</option>
                                        {{#each this.skillGroups}}
                                            <optgroup label="{{this.label}}">
                                                {{#each this.skills}}
                                                    <option value="{{this.identificationKey}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
                                                {{/each}}
                                            </optgroup>
                                        {{/each}}
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>目標値</label>
                                    <div class="number-input-spinner">
                                        <button type="button" class="tnx-btn" data-action="presetSpinDown" aria-label="減少">−</button>
                                        <input type="number" name="targetValue" value="{{this.targetValue}}" min="0" max="99"
                                               data-preset-kind="checkRequests" data-preset-id="{{this.id}}">
                                        <button type="button" class="tnx-btn" data-action="presetSpinUp" aria-label="増加">＋</button>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="rl-check-label">
                                        <input type="checkbox" name="targetValueHidden" {{checked this.targetValueHidden}}
                                               data-preset-kind="checkRequests" data-preset-id="{{this.id}}">
                                        <span>目標値をプレイヤーに非公開</span>
                                    </label>
                                </div>
                                <div class="form-group">
                                    <label>説明</label>
                                    <input type="text" name="description" value="{{this.description}}"
                                           data-preset-kind="checkRequests" data-preset-id="{{this.id}}">
                                </div>
                            </div>
                        </div>
                    {{else}}
                        <div class="no-items-placeholder">
                            <p>判定要求がありません。「判定要求を追加」から作成してください。</p>
                        </div>
                    {{/each}}
                </div>

                <div class="tnx-section-header">
                    <h3>報酬点</h3>
                    <button type="button" class="tnx-btn tnx-btn--sm" data-action="addBountyPreset">
                        <i class="fas fa-plus"></i> 報酬点を追加
                    </button>
                </div>
                <div class="preset-list">
                    {{#each bountyPresets}}
                        <div class="preset-item" data-preset-id="{{this.id}}">
                            <div class="tnx-item-header tnx-item-header--card">
                                <input type="text" name="label" value="{{this.label}}" placeholder="{{this.placeholder}}"
                                       data-preset-kind="bountyGrants" data-preset-id="{{this.id}}">
                                <div class="tnx-ctrl-strip">
                                    <a class="tnx-icon-ctrl" data-action="presetUp"   data-preset-kind="bountyGrants" data-preset-id="{{this.id}}" title="上へ"><i class="fas fa-chevron-up"></i></a>
                                    <a class="tnx-icon-ctrl" data-action="presetDown" data-preset-kind="bountyGrants" data-preset-id="{{this.id}}" title="下へ"><i class="fas fa-chevron-down"></i></a>
                                    <a class="tnx-icon-ctrl" data-action="deletePreset" data-preset-kind="bountyGrants" data-preset-id="{{this.id}}" title="削除"><i class="fas fa-trash"></i></a>
                                </div>
                            </div>
                            <div class="preset-body">
                                <div class="form-group">
                                    <label>点数</label>
                                    <div class="number-input-spinner">
                                        <button type="button" class="tnx-btn" data-action="presetSpinDown" aria-label="減少">−</button>
                                        <input type="number" name="amount" value="{{this.amount}}" min="-99" max="99"
                                               data-preset-kind="bountyGrants" data-preset-id="{{this.id}}">
                                        <button type="button" class="tnx-btn" data-action="presetSpinUp" aria-label="増加">＋</button>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label>記述</label>
                                    <input type="text" name="note" value="{{this.note}}"
                                           data-preset-kind="bountyGrants" data-preset-id="{{this.id}}">
                                </div>
                            </div>
                        </div>
                    {{else}}
                        <div class="no-items-placeholder">
                            <p>報酬点がありません。「報酬点を追加」から作成してください。</p>
                        </div>
                    {{/each}}
                </div>

                <div class="tnx-section-header">
                    <h3>ダメージ</h3>
                    <button type="button" class="tnx-btn tnx-btn--sm" data-action="addDamageGrantPreset">
                        <i class="fas fa-plus"></i> ダメージを追加
                    </button>
                </div>
                <div class="preset-list">
                    {{#each damageGrantPresets}}
                        <div class="preset-item" data-preset-id="{{this.id}}">
                            <div class="tnx-item-header tnx-item-header--card">
                                <input type="text" name="label" value="{{this.label}}" placeholder="{{this.placeholder}}"
                                       data-preset-kind="damageGrants" data-preset-id="{{this.id}}">
                                <div class="tnx-ctrl-strip">
                                    <a class="tnx-icon-ctrl" data-action="presetUp"   data-preset-kind="damageGrants" data-preset-id="{{this.id}}" title="上へ"><i class="fas fa-chevron-up"></i></a>
                                    <a class="tnx-icon-ctrl" data-action="presetDown" data-preset-kind="damageGrants" data-preset-id="{{this.id}}" title="下へ"><i class="fas fa-chevron-down"></i></a>
                                    <a class="tnx-icon-ctrl" data-action="deletePreset" data-preset-kind="damageGrants" data-preset-id="{{this.id}}" title="削除"><i class="fas fa-trash"></i></a>
                                </div>
                            </div>
                            <div class="preset-body">
                                <div class="form-group">
                                    <label>系統</label>
                                    <select name="category" data-preset-kind="damageGrants" data-preset-id="{{this.id}}">
                                        {{#each this.categories}}
                                            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                                        {{/each}}
                                    </select>
                                </div>
                                {{!-- 決め方（固定／カードを出す通常算出・2026-07-24） --}}
                                <div class="form-group">
                                    <label>決め方</label>
                                    <select name="mode" data-preset-kind="damageGrants" data-preset-id="{{this.id}}">
                                        {{#each this.modes}}
                                            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                                        {{/each}}
                                    </select>
                                </div>
                                {{!-- ダメージ＝種別＋値の1項目（攻撃力の設定と同じ split-fields）。
                                      値ラベルはモードに追随（固定＝ダメージ／カード＝基準値） --}}
                                <div class="form-group damage-fields-group">
                                    <label class="damage-value-label">{{this.valueLabel}}</label>
                                    <div class="form-fields split-fields">
                                        <select name="damageType" class="damage-type-field"
                                                data-preset-kind="damageGrants" data-preset-id="{{this.id}}">
                                            {{#each this.damageTypes}}
                                                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                                            {{/each}}
                                        </select>
                                        <div class="number-input-spinner">
                                            <button type="button" class="tnx-btn" data-action="presetSpinDown" aria-label="減少">−</button>
                                            <input type="number" name="value" value="{{this.value}}" min="0" max="99"
                                                   data-preset-kind="damageGrants" data-preset-id="{{this.id}}">
                                            <button type="button" class="tnx-btn" data-action="presetSpinUp" aria-label="増加">＋</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label>記述</label>
                                    <input type="text" name="note" value="{{this.note}}"
                                           data-preset-kind="damageGrants" data-preset-id="{{this.id}}">
                                </div>
                            </div>
                        </div>
                    {{else}}
                        <div class="no-items-placeholder">
                            <p>ダメージがありません。「ダメージを追加」から作成してください。</p>
                        </div>
                    {{/each}}
                </div>

                <div class="tnx-section-header">
                    <h3>効果</h3>
                    <button type="button" class="tnx-btn tnx-btn--sm" data-action="addEffectGrantPreset">
                        <i class="fas fa-plus"></i> 効果を追加
                    </button>
                </div>
                <div class="preset-list">
                    {{#each effectGrantPresets}}
                        <div class="preset-item" data-preset-id="{{this.id}}">
                            <div class="tnx-item-header tnx-item-header--card">
                                <input type="text" name="label" value="{{this.label}}" placeholder="{{this.placeholder}}"
                                       data-preset-kind="effectGrants" data-preset-id="{{this.id}}">
                                <div class="tnx-ctrl-strip">
                                    <a class="tnx-icon-ctrl" data-action="presetUp"   data-preset-kind="effectGrants" data-preset-id="{{this.id}}" title="上へ"><i class="fas fa-chevron-up"></i></a>
                                    <a class="tnx-icon-ctrl" data-action="presetDown" data-preset-kind="effectGrants" data-preset-id="{{this.id}}" title="下へ"><i class="fas fa-chevron-down"></i></a>
                                    <a class="tnx-icon-ctrl" data-action="deletePreset" data-preset-kind="effectGrants" data-preset-id="{{this.id}}" title="削除"><i class="fas fa-trash"></i></a>
                                </div>
                            </div>
                            <div class="preset-body">
                                {{!-- 効果の見せ方はシステム標準の効果リストに揃える --}}
                                <div class="tnx-item-list tnx-item-list--effects">
                                    <div class="tnx-item-list__row">
                                        <div class="tnx-item-list__column--main">
                                            <img class="effect-image" src="{{this.effect.img}}" alt="{{this.effect.name}}"/>
                                            <h4 class="{{#unless this.effect.set}}disabled{{/unless}}">{{this.effect.name}}</h4>
                                        </div>
                                        <div class="tnx-item-list__column--summary">{{this.effect.summary}}</div>
                                        <div class="tnx-item-list__column--controls">
                                            {{#if this.effect.set}}
                                                <a class="tnx-icon-ctrl" data-action="editEffectPreset"
                                                   data-preset-id="{{this.id}}" title="編集"><i class="fas fa-edit"></i></a>
                                            {{else}}
                                                <a class="tnx-icon-ctrl" data-action="editEffectPreset"
                                                   data-preset-id="{{this.id}}" title="作成"><i class="fas fa-plus"></i></a>
                                            {{/if}}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {{else}}
                        <div class="no-items-placeholder">
                            <p>効果がありません。「効果を追加」から作成してください。</p>
                        </div>
                    {{/each}}
                </div>

            </div>
        </div>
    </section>
</section>
