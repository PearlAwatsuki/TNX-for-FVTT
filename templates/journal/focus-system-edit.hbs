<div class="tnx-focus-system tokyo-nova">

    <fieldset class="tnx-fieldset">
        <legend>FS判定</legend>
        <div class="usage-form-section">
            <div class="form-group">
                <label>制限</label>
                <input type="text" name="system.restriction" value="{{system.restriction}}" placeholder="参加条件（省略可）">
            </div>
            <div class="form-group">
                <label>目標進行値</label>
                <div class="number-input-spinner">
                    <button type="button" class="tnx-btn" data-action="spinDown" aria-label="減少">−</button>
                    <input type="number" name="system.targetProgress" value="{{system.targetProgress}}" min="0" max="99">
                    <button type="button" class="tnx-btn" data-action="spinUp" aria-label="増加">＋</button>
                </div>
            </div>
            <div class="form-group">
                <label>支援判定の技能</label>
                <select name="system.supportSkillKey">
                    <option value="">（指定なし）</option>
                    {{#each skillGroups}}
                        <optgroup label="{{this.label}}">
                            {{#each this.skills}}
                                <option value="{{this.identificationKey}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
                            {{/each}}
                        </optgroup>
                    {{/each}}
                </select>
            </div>
        </div>
    </fieldset>

    <fieldset class="tnx-fieldset">
        <legend>敗北条件</legend>
        <div class="usage-form-section">
            <div class="form-group">
                <label>条件</label>
                <select name="system.defeatCondition.type" class="fs-defeat-type">
                    {{#each defeatTypes}}
                        <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="form-group fs-defeat-cut" {{#unless isDefeatCut}}hidden{{/unless}}>
                <label>敗北カット数</label>
                <div class="number-input-spinner">
                    <button type="button" class="tnx-btn" data-action="spinDown" aria-label="減少">−</button>
                    <input type="number" name="system.defeatCondition.cutLimit" value="{{system.defeatCondition.cutLimit}}" min="0" max="99">
                    <button type="button" class="tnx-btn" data-action="spinUp" aria-label="増加">＋</button>
                </div>
            </div>
            <div class="form-group fs-defeat-other" {{#if isDefeatCut}}hidden{{/if}}>
                <label>内容</label>
                <input type="text" name="system.defeatCondition.text" value="{{system.defeatCondition.text}}">
            </div>
            <div class="form-group">
                <label>敗北時の処理</label>
                <input type="text" name="system.defeatEffect" value="{{system.defeatEffect}}" placeholder="ダメージを受ける など（省略可）">
            </div>
        </div>
    </fieldset>

    <fieldset class="tnx-fieldset">
        <legend>進行判定</legend>
        <div class="tnx-item-header">
            <h5>判定行</h5>
            <a class="tnx-ring-btn" data-action="addRow" title="判定行を追加"><i class="fas fa-plus"></i></a>
        </div>
        <div class="fs-row-list">
            {{#each rows}}
                <div class="fs-row" data-index="{{this.index}}">
                    <div class="tnx-item-header">
                        <span class="fs-row-title">進行値 {{this.threshold}} から</span>
                        <div class="tnx-ctrl-strip">
                            <a class="tnx-icon-ctrl" data-action="rowUp"     title="上へ"><i class="fas fa-chevron-up"></i></a>
                            <a class="tnx-icon-ctrl" data-action="rowDown"   title="下へ"><i class="fas fa-chevron-down"></i></a>
                            <a class="tnx-icon-ctrl" data-action="deleteRow" title="この行を削除"><i class="fas fa-trash"></i></a>
                        </div>
                    </div>
                    <div class="usage-form-section">
                        <div class="form-group">
                            <label>進行値</label>
                            <div class="number-input-spinner">
                                <button type="button" class="tnx-btn" data-action="spinDown" aria-label="減少">−</button>
                                <input type="number" name="system.rows.{{this.index}}.threshold" value="{{this.threshold}}" min="0" max="99">
                                <button type="button" class="tnx-btn" data-action="spinUp" aria-label="増加">＋</button>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>技能</label>
                            <select name="system.rows.{{this.index}}.skillKey">
                                <option value="">（指定なし）</option>
                                {{#each this.skillGroups}}
                                    <optgroup label="{{this.label}}">
                                        {{#each this.skills}}
                                            <option value="{{this.identificationKey}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
                                        {{/each}}
                                    </optgroup>
                                {{/each}}
                            </select>
                        </div>
                        <div class="form-group">
                            <label>目標値</label>
                            <div class="number-input-spinner">
                                <button type="button" class="tnx-btn" data-action="spinDown" aria-label="減少">−</button>
                                <input type="number" name="system.rows.{{this.index}}.targetValue" value="{{this.targetValue}}" min="0" max="99">
                                <button type="button" class="tnx-btn" data-action="spinUp" aria-label="増加">＋</button>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>進行修正の参照元</label>
                            <select name="system.rows.{{this.index}}.progressMod.source" class="fs-mod-source">
                                {{#each ../sourceOptions}}
                                    <option value="{{this.value}}">{{this.label}}</option>
                                {{/each}}
                            </select>
                        </div>
                        <div class="form-group fs-mod-param" {{#unless this.hasParam}}hidden{{/unless}}>
                            <label>パラメータ</label>
                            <select name="system.rows.{{this.index}}.progressMod.param">
                                {{#each this.paramGroups}}
                                    <optgroup label="{{this.label}}">
                                        {{#each this.params}}
                                            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                                        {{/each}}
                                    </optgroup>
                                {{/each}}
                            </select>
                        </div>
                        <div class="form-group">
                            <label>進行修正</label>
                            <input type="text" name="system.rows.{{this.index}}.progressMod.formula"
                                   value="{{this.progressMod.formula}}" placeholder="{{this.formulaPlaceholder}}">
                        </div>
                        <div class="form-group">
                            <label>備考</label>
                            <input type="text" name="system.rows.{{this.index}}.note" value="{{this.note}}">
                        </div>
                    </div>
                </div>
            {{else}}
                <div class="no-items-placeholder">
                    <p>判定行がありません。「＋」から追加してください。</p>
                </div>
            {{/each}}
        </div>
    </fieldset>

    <fieldset class="tnx-fieldset">
        <legend>メモ</legend>
        <textarea name="system.memo" rows="4">{{system.memo}}</textarea>
    </fieldset>

</div>
