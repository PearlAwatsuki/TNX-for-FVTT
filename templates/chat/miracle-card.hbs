{{!-- 神業カード(17-1)。神業の使用を卓に提示する——種別タグ「神業」＋名前(ふりがなはルビ)＋
      効果文＋条件(経験点「うまく神業を使った」の取得条件)＋残り使用回数。
      意匠は送信カードと同じ .tnx-check-request ＋ cr-req-header ＋ cr-req-body を踏襲する。
      効果文と条件はエンリッチ済み HTML。空の欄は行ごと出さない --}}
<div class="tnx-check-request tokyo-nova tnx-miracle-card">

    <header class="cr-req-header">
        <span class="cr-req-type-tag">{{typeLabel}}</span>
        <span class="cr-req-title">{{#if furigana}}<ruby>{{name}}<rt>{{furigana}}</rt></ruby>{{else}}{{name}}{{/if}}</span>
    </header>

    <div class="cr-req-body">
        {{#if description}}
            <div class="cr-req-prose mc-description">{{{description}}}</div>
        {{/if}}

        {{#if condition}}
            <div class="mc-condition">
                <span class="mc-condition__label">条件</span>
                <div class="cr-req-prose">{{{condition}}}</div>
            </div>
        {{/if}}

        <div class="cr-req-field mc-uses">
            <span class="cr-req-field__label">残り使用回数</span>
            <span class="cr-req-field__value">{{remaining}} / {{max}}</span>
        </div>
    </div>
</div>
