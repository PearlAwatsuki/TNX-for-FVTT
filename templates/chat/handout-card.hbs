{{!-- ハンドアウト送信カード(2026-08-12)。骨格・段は統一規格の部品で組む(2026-09-05)。
      最下部のコネ受け取りボタンは renderChatMessageHTML フック(handout-contact.mjs)が注入する --}}
{{#> tnxCard cardClass="tnx-handout-card" typeLabel="ハンドアウト" title=title}}

    {{!-- 担当・スタイル・コネ・推奨スート。空の欄は行ごと出さない --}}
    {{#if playerName}}{{> tnxCardField label="担当" value=playerName}}{{/if}}
    {{#if styleName}}{{> tnxCardField label="スタイル" value=styleName}}{{/if}}
    {{#if contactName}}{{> tnxCardField label="コネ" value=contactName}}{{/if}}
    {{#if suitLabel}}{{> tnxCardField label="推奨スート" value=suitLabel}}{{/if}}

    {{> tnxCardText content=content textClass="ho-content"}}

    {{#if ps}}
        <div class="ho-ps">
            <span class="ho-ps__label">PS</span>
            <div class="ho-ps__body tnx-card__text">{{{ps}}}</div>
        </div>
    {{/if}}

    {{!-- コネの受け取り(フックが「コネを受け取る」ボタン or 生成済みを注入する) --}}
    <div class="ho-contact-action"></div>
{{/tnxCard}}
