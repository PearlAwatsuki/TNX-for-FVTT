{{!-- 状態の効果決定 受付カード(衰弱/重圧のカードドロー等)。判定結果カードの意匠を踏襲。
     ボタンは .tnx-condition-action(bindConditionChatButtons が配線)。素のインライン div の置き換え(2026-07-09)。 --}}
<div class="tnx-check-result tnx-condition-card tokyo-nova">
    <div class="cr-head">
        <span class="cr-skill-name">{{label}}</span>
        <span class="cr-type-tag">効果決定</span>
    </div>
    <div class="tnx-condition-body">
        <p class="tnx-condition-note">{{promptText}}</p>
        <button type="button" class="tnx-chat-btn tnx-condition-action" data-type="{{type}}"
            data-actor="{{actorUuid}}" data-effect="{{effectId}}" data-kind="{{kind}}">
            <i class="fas fa-diamond"></i> {{buttonLabel}}
        </button>
    </div>
</div>
