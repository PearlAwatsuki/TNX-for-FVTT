{{!-- ヴィークル操縦移動カード(フェーズ12・2026-07-19 基底化)。判定結果カードの基底
     (check-card-head/check-calc-rows)に移動情報(達成値÷10 段階)を足す形式。
     対応する操縦で判定し、達成値÷10(切り捨て)段階の移動が可能。
     段階移動そのものの適用は移動・位置の機構へ後付け(ここでは段階数の提示まで)。 --}}
<div class="tnx-check-result tnx-move-card tokyo-nova">

    {{> "systems/tokyo-nova-axleration/templates/chat/parts/check-card-head.hbs"}}

    {{#if result.fumble}}
    <div class="cr-result cr-result--fumble"><i class="fas fa-skull"></i> <span>ファンブル！（移動失敗）</span></div>
    {{else}}
        {{#if suitMismatch}}
        <div class="cr-result cr-result--failure"><i class="fas fa-times"></i> <span>スート不一致（判定不成立・移動なし）</span></div>
        {{else}}
        <div class="cr-calc-section">
            {{> "systems/tokyo-nova-axleration/templates/chat/parts/check-calc-rows.hbs"}}
            {{!-- 使用ヴィークル=攻撃力と同じ計算行スロット(総計の直前・2026-07-19 是正) --}}
            <div class="cr-calc-row">
                <span class="cr-calc-label">使用ヴィークル</span>
                <span class="cr-calc-val">{{vehicleName}}</span>
            </div>
            <div class="cr-calc-row cr-total-row">
                <span class="cr-calc-label">達成値</span>
                <span class="cr-total-num">{{result.achievement}}</span>
            </div>
            {{!-- 段階数=主情報を達成値の直下に強調表示(式は出さない・2026-07-19 ユーザー指摘) --}}
            <div class="cr-calc-row cr-total-row">
                <span class="cr-calc-label">移動</span>
                <span class="cr-total-num">{{stages}}<span class="cr-total-unit"> 段階</span></span>
            </div>
        </div>
        {{!-- 達成値10未満=0段階はその時点で移動失敗・1段階以上は移動成功(2026-07-19 ユーザー確定) --}}
        {{#if stages}}
        <div class="cr-result cr-result--success"><i class="fas fa-check"></i> <span>移動成功</span></div>
        {{else}}
        <div class="cr-result cr-result--failure"><i class="fas fa-times"></i> <span>移動失敗</span></div>
        {{/if}}
        {{/if}}
    {{/if}}
</div>
