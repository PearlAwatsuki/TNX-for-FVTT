{{!-- ヴィークル操縦移動カード(フェーズ12・2026-07-19 基底化／2026-09-05 統一規格へ)。判定結果カードの
     段(check-card-row/check-calc-rows)に移動情報(達成値÷10 段階)を足す形式。
     対応する操縦で判定し、達成値÷10(切り捨て)段階の移動が可能。
     段階移動そのものの適用は移動・位置の機構へ後付け(ここでは段階数の提示まで)。 --}}
{{#> tnxCard cardClass="tnx-move-card" typeLabel=typeLabel title=skillLabel}}
    <span hidden data-tnx-movement-stages="{{stages}}"></span>

    {{> "systems/tokyo-nova-axleration/templates/chat/parts/check-card-row.hbs"}}

    {{#if result.fumble}}
        {{#> tnxCardResult resultClass="tnx-card__result--fumble"}}<i class="fas fa-skull"></i> ファンブル！（移動失敗）{{/tnxCardResult}}
    {{else if suitMismatch}}
        {{#> tnxCardResult resultClass="tnx-card__result--failure"}}<i class="fas fa-times"></i> スート不一致（判定不成立・移動なし）{{/tnxCardResult}}
    {{else}}
        <div class="tnx-card__section">
            {{> "systems/tokyo-nova-axleration/templates/chat/parts/check-calc-rows.hbs"}}
            {{!-- 使用ヴィークル=攻撃力と同じ計算行スロット(総計の直前・2026-07-19 是正) --}}
            {{> tnxCardField label="使用ヴィークル" value=vehicleName}}
            {{> tnxCardField label="達成値" value=result.achievement fieldClass="tnx-card__field--total" valueClass="tnx-card__field-value--total"}}
            {{!-- 段階数=主情報を達成値の直下に強調表示(式は出さない・2026-07-19 ユーザー指摘) --}}
            {{#> tnxCardRow label="移動" rowClass="tnx-card__field--total" rowValueClass="tnx-card__field-value--total"}}{{stages}}<span class="tnx-card__field-unit"> 段階</span>{{/tnxCardRow}}
        </div>
        {{!-- 達成値10未満=0段階はその時点で移動失敗・1段階以上は移動成功(2026-07-19 ユーザー確定) --}}
        {{#if stages}}
            {{#> tnxCardResult resultClass="tnx-card__result--success"}}<i class="fas fa-check"></i> 移動成功{{/tnxCardResult}}
        {{else}}
            {{#> tnxCardResult resultClass="tnx-card__result--failure"}}<i class="fas fa-times"></i> 移動失敗{{/tnxCardResult}}
        {{/if}}
    {{/if}}
{{/tnxCard}}
