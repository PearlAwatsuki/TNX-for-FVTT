{{!-- 判定要求カード。タグ＝判定の種別(技能判定/制御判定/登場判定…)・名前＝技能名。
      対象ごとの「判定する」ボタン/結果は renderChatMessageHTML フックが注入する
      (2026-07-19: ユーザー参照を撤去＝ボタンはアクターの所有者権限で出す)。
      骨格・段は統一規格の部品で組む(2026-09-05) --}}
{{#> tnxCard typeLabel=typeLabel title=skillLabel}}

    {{#if validSuits.length}}
        {{#> tnxCardRow label="スート" rowValueClass="cr-req-suits"}}
            {{#each validSuits}}<span class="cr-req-suit suit-{{this}}">{{lookup ../suitSymbols this}}</span>{{/each}}
        {{/tnxCardRow}}
    {{/if}}

    {{#if description}}<p class="tnx-card__note">{{description}}</p>{{/if}}

    {{#> tnxCardRow label="目標値" rowClass="tnx-card__field--tn" rowValueClass="tnx-card__field-value--tn"}}
        <span data-hidden="{{targetValueHidden}}">{{#if targetValue}}{{targetValue}}{{else}}—{{/if}}</span>
    {{/tnxCardRow}}

    <ul class="tnx-card__targets">
        {{#each targets}}
            <li class="tnx-card__target" data-actor-id="{{this.actorId}}">
                <span class="tnx-card__target-name">{{this.actorName}}</span>
                <div class="tnx-card__target-status"></div>
            </li>
        {{/each}}
    </ul>
{{/tnxCard}}
