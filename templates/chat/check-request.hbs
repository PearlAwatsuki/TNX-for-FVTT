<div class="tnx-check-request tokyo-nova">

    {{!-- ヘッダー --}}
    <header class="cr-req-header">
        <span class="cr-req-type-tag">{{typeLabel}}</span>
        <span class="cr-req-title">判定要求</span>
    </header>

    <div class="cr-req-body">

        {{!-- 技能名 + スート --}}
        <div class="cr-req-skill-row">
            <span class="cr-req-skill-name">{{skillLabel}}</span>
            {{#if validSuits.length}}
                <span class="cr-req-suits">
                    {{#each validSuits}}
                        <span class="cr-req-suit suit-{{this}}">{{lookup ../suitSymbols this}}</span>
                    {{/each}}
                </span>
            {{/if}}
        </div>

        {{!-- 説明文 --}}
        {{#if description}}
            <p class="cr-req-description">{{description}}</p>
        {{/if}}

        {{!-- 目標値 --}}
        <div class="cr-req-tn-row">
            <span class="cr-req-tn-label">目標値</span>
            <span class="cr-req-tn-value" data-hidden="{{targetValueHidden}}">
                {{#if targetValue}}{{targetValue}}{{else}}—{{/if}}
            </span>
        </div>

        {{!-- 対象アクター一覧（ステータスは renderChatMessage フックが注入。2026-07-19:
              ユーザー参照を撤去=判定ボタンはアクターの所有者権限で判定する --}}
        <ul class="cr-req-targets">
            {{#each targets}}
                <li class="cr-req-target-row" data-actor-id="{{this.actorId}}">
                    <span class="cr-req-actor-name">{{this.actorName}}</span>
                    <div class="cr-req-target-status">
                        {{!-- フックが「判定する」ボタン or 結果を注入する --}}
                    </div>
                </li>
            {{/each}}
        </ul>

    </div>
</div>
