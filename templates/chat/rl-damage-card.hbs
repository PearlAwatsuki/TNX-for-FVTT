{{!-- RL 任意ダメージの「ダメージ算出前」中間カード(2026-07-24／2026-09-05 統一規格へ)。命中確定・判定表示なし。
     対象リスト・カバー導線・「ダメージカードを出す／ダメージを算出」ボタンは .tnx-attack-status に
     renderChatMessageHTML(attack-flow.renderAttackCard)がフラグ(attackCheck・rlGrant)からライブ描画する。
     攻撃ではなく中立に「ダメージ付与」表記(判定内訳＝達成値・スート・カードは出さない)。 --}}
{{#> tnxCard cardClass="tnx-attack-card tnx-rl-damage-card" typeLabel="ダメージ付与" title=categoryLabel}}
    {{#if summaryRows.length}}
        <div class="tnx-card__section">
            {{#each summaryRows}}{{> tnxCardField label=this.label value=this.value}}{{/each}}
        </div>
    {{/if}}
    {{!-- 対象リスト・カバー導線・ダメージボタン(renderAttackCard がフラグから描画) --}}
    <div class="tnx-attack-status"></div>
{{/tnxCard}}
