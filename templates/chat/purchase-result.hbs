{{!-- 購入の結果カード(16-3): 常時入手(isAlways)とカードなし特例。カード判定の結果は
     check-result.hbs の purchase ブロックが担う。統一規格の骨格・段で組む(2026-09-05。
     計算内訳は全行表示の規約)。 --}}
{{#> tnxCard typeLabel="購入判定" title=itemName}}

    <div class="cr-card-row">
        <span class="cr-card-name">{{#if isAlways}}常時入手（購入値が外界点以下）{{else}}カードを出さずに購入（外界＋報酬点）{{/if}}</span>
    </div>

    <div class="tnx-card__section">
        {{> tnxCardField label="購入値" value=targetValue}}
        {{> tnxCardField label="外界" value=mundane}}
        {{#unless isAlways}}
            {{> tnxCardField label="消費報酬点" value=bountySpent}}
            {{> tnxCardField label="達成値" value=achievement fieldClass="tnx-card__field--total" valueClass="tnx-card__field-value--total"}}
        {{/unless}}
    </div>

    {{#unless isAlways}}
        {{#> tnxCardResult resultClass=(concat "tnx-card__result--" (ifThen success "success" "failure"))}}
            {{#if success}}<i class="fas fa-check"></i> 成功{{else}}<i class="fas fa-times"></i> 失敗{{/if}}
            <span class="tnx-card__result-note">目標値 {{targetValue}}</span>
            {{#if diffDisplay}}<span class="tnx-card__result-note">差分値 {{diffDisplay}}</span>{{/if}}
        {{/tnxCardResult}}
    {{/unless}}

    {{#if isAlways}}
        <div class="tnx-card__outcome"><i class="fas fa-cart-shopping"></i> {{itemName}}を入手した</div>
    {{else if granted}}
        <div class="tnx-card__outcome"><i class="fas fa-cart-shopping"></i> {{itemName}}を入手した</div>
    {{/if}}
{{/tnxCard}}
