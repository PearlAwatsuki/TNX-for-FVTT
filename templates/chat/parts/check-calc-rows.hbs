{{!-- 判定結果カードの基底②: 標準計算行(代用/スート変更/数字上書き/カード値/能力値/報酬点/
     判定ボーナス/修正(手動)/不成立ラベル)。**達成値の総計行は含まない**——各カードが固有行
     (攻撃力等)を足してから総計行を閉じる(2026-07-19 基底化)。tnx-card__section の内側で使う。 --}}
{{#if substitution}}
<div class="tnx-card__field">
    <span class="tnx-card__field-label">代用（指定技能）</span>
    <span class="tnx-card__field-value">{{substitution.requestedLabel}}</span>
</div>
{{/if}}
{{#unless isFixed21}}{{#unless suitMismatch}}
{{#if suitChangedDisplay}}
<div class="tnx-card__field">
    <span class="tnx-card__field-label">スート変更</span>
    <span class="tnx-card__field-value">{{suitChangedDisplay}}</span>
</div>
{{/if}}
{{#if cardOverrideDisplay}}
<div class="tnx-card__field">
    <span class="tnx-card__field-label">数字上書き</span>
    <span class="tnx-card__field-value">{{cardOverrideDisplay}}</span>
</div>
{{/if}}
<div class="tnx-card__field">
    <span class="tnx-card__field-label">カード値</span>
    <span class="tnx-card__field-value">{{result.cardValue}}</span>
</div>
<div class="tnx-card__field">
    <span class="tnx-card__field-label">{{abilityLabel}}</span>
    <span class="tnx-card__field-value">+{{result.abilityVal}}</span>
</div>
{{#if result.bountyUsed}}
<div class="tnx-card__field">
    <span class="tnx-card__field-label">報酬点</span>
    <span class="tnx-card__field-value">+{{result.bountyUsed}}</span>
</div>
{{/if}}
{{#if hasCheckBonus}}
{{#if checkSources.length}}
<details class="tnx-card__fold">
    <summary class="tnx-card__field tnx-card__fold-summary">
        <span class="tnx-card__field-label">判定ボーナス</span>
        <span class="tnx-card__field-value">{{signed result.checkBonus}}</span>
    </summary>
    <ul class="tnx-card__fold-list">
        {{#each checkSources}}
        <li><span class="tnx-card__fold-name">{{this.name}}</span><span class="tnx-card__fold-num">{{signed this.value}}</span></li>
        {{/each}}
    </ul>
</details>
{{else}}
<div class="tnx-card__field">
    <span class="tnx-card__field-label">判定ボーナス</span>
    <span class="tnx-card__field-value">{{signed result.checkBonus}}</span>
</div>
{{/if}}
{{/if}}
{{#if manualModDisplay}}
<div class="tnx-card__field">
    <span class="tnx-card__field-label">修正（手動）</span>
    <span class="tnx-card__field-value">{{manualModDisplay}}</span>
</div>
{{/if}}
{{/unless}}{{/unless}}
{{#if suitMismatch}}
<div class="cr-mismatch-label">
    <i class="fas fa-times"></i> 判定不成立
</div>
{{/if}}
