{{!-- ニューロカードの提示カード。統一規格の骨格で組む(2026-09-05)——タグ＝「ニューロカード」・
     名前＝カード名。絵札とローマ字綴りはこのカード固有の意匠、キーワード/暗示は共通の段。 --}}
{{#> tnxCard cardClass="tnx-neuro-card-chat" typeLabel="ニューロカード" title=cardName}}
    {{#if cardImage}}
        <img class="tnx-neuro-card-chat__image" src="{{cardImage}}" alt="{{cardName}}">
    {{/if}}
    {{#if cardNameRomaji}}
        <div class="tnx-neuro-card-chat__romaji">{{cardNameRomaji}}</div>
    {{/if}}
    {{> tnxCardField label="キーワード" valueHtml=keyword}}
    {{> tnxCardField label="暗示" valueHtml=implication}}
{{/tnxCard}}
