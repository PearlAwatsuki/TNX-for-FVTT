{{!-- 状態の解決結果カード(治療・カード決定ドロー等)。判定結果カード(check-result)の意匠を踏襲。
     素の tnx-condition-result インライン div の置き換え(2026-07-09)。 --}}
<div class="tnx-check-result tnx-condition-card tokyo-nova">
    <div class="jr-head">
        <span class="jr-skill-name">{{title}}</span>
        {{#if tag}}<span class="jr-type-tag">{{tag}}</span>{{/if}}
    </div>
    <div class="jr-result jr-result--{{status}}">
        <i class="fas {{icon}}"></i>
        <span>{{#if label}}「{{label}}」{{/if}}{{text}}</span>
    </div>
</div>
