<div class="tnx-check-request tokyo-nova">

    <header class="cr-req-header">
        <span class="cr-req-type-tag">{{amountLabel}}</span>
        <span class="cr-req-title">報酬点</span>
    </header>

    <div class="cr-req-body">

        {{#if note}}
            <p class="cr-req-description">{{note}}</p>
        {{/if}}

        {{!-- 対象一覧（ボタン／受け取り済みは renderChatMessageHTML フックが注入） --}}
        <ul class="cr-req-targets">
            {{#each targets}}
                <li class="cr-req-target-row" data-uuid="{{this.uuid}}">
                    <span class="cr-req-actor-name">{{this.name}}</span>
                    <div class="cr-req-target-status"></div>
                </li>
            {{/each}}
        </ul>

    </div>
</div>
