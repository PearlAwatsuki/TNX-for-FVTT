{{!-- FS判定の結果カード。タグ＝「FS判定」・名前＝FS名。骨格・段は統一規格の部品で組む(2026-09-05) --}}
{{#> tnxCard typeLabel="FS判定" title=name}}
    {{#if succeeded}}
        {{#> tnxCardResult resultClass="tnx-card__result--nodamage"}}<i class="fas fa-flag-checkered"></i> 目標達成{{/tnxCardResult}}
    {{else}}
        {{#> tnxCardResult resultClass="tnx-card__result--damage"}}<i class="fas fa-skull"></i> 敗北{{/tnxCardResult}}
    {{/if}}

    {{#> tnxCardRow label="進行値" rowClass="tnx-card__field--tn" rowValueClass="tnx-card__field-value--tn"}}{{progress}} / {{targetProgress}}{{/tnxCardRow}}
    {{#if isDefeatCut}}
        {{#> tnxCardRow label="カット" rowClass="tnx-card__field--tn" rowValueClass="tnx-card__field-value--tn"}}{{cut}} / {{cutLimit}}{{/tnxCardRow}}
    {{/if}}

    {{#unless succeeded}}
        {{#if defeatEffect}}<p class="tnx-card__note">{{defeatEffect}}</p>{{/if}}
    {{/unless}}
{{/tnxCard}}
