{{!-- シーン切替カード(2026-08-15)。タグ＝上演中のシーン番号・名前＝シーン名。
      ルーラーシーンはシーンプレイヤー行の代わりに「ルーラーシーン」とだけ出す(2026-08-08 裁定)。
      骨格・段は統一規格の部品で組む(2026-09-05) --}}
{{#> tnxCard cardClass="tnx-scene-switch-card" typeLabel=sceneLabel title=name}}
    {{#if rulerScene}}
        {{> tnxCardField value="ルーラーシーン"}}
    {{else if playerLabel}}
        {{> tnxCardField label="シーンプレイヤー" value=playerLabel}}
    {{/if}}

    {{!-- 切替メッセージは台本の長文(ProseMirror)。上の行と罫線で切る --}}
    {{> tnxCardText content=message textClass="sc-message"}}
{{/tnxCard}}
