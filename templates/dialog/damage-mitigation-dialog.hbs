{{!-- ダメージ軽減ダイアログ(防御側・フェーズ12-3)。ダメージ・カードの[適用]から
     対象の操作者(または RL)に対して開く。防御力+パリー受け値は自動、社会攻撃は報酬点による
     軽減(2026-07-08 ユーザー指示: 防御側に別途ダイアログ)。技能等による軽減は手動欄に入力する。 --}}
<div class="tnx-damage-form">
    <p class="tnx-damage-summary">
        {{targetName}} への {{categoryLabel}}ダメージ（攻撃側合計 <b>{{raw}}</b>{{#if canStun}}・{{stunLabel}}可（確定前に選択）{{/if}}）
    </p>

    <div class="tnx-damage-fields">
        <div class="form-group">
            <label>軽減{{#if mitigationParts.length}}（自動: {{#each mitigationParts}}{{this}}{{#unless @last}}・{{/unless}}{{/each}}）{{/if}}</label>
            <div class="number-input-spinner">
                <button type="button" class="tnx-btn" data-action="decrement" aria-label="Decrease">-</button>
                <input type="number" name="mitigation" value="{{autoMitigation}}" min="-99" max="99">
                <button type="button" class="tnx-btn" data-action="increment" aria-label="Increase">+</button>
            </div>
        </div>
        {{#if isSocial}}
        <div class="form-group">
            <label>報酬点による軽減 <i class="fas fa-circle-question" title="社会攻撃はリアクションの〈信用〉判定が成立していれば報酬点で軽減できます"></i></label>
            <div class="number-input-spinner">
                <button type="button" class="tnx-btn" data-action="decrement" aria-label="Decrease">-</button>
                <input type="number" name="bountyMitigation" value="0" min="0" max="99">
                <button type="button" class="tnx-btn" data-action="increment" aria-label="Increase">+</button>
            </div>
        </div>
        {{/if}}
    </div>

    {{!-- ライブプレビュー(最終値・負傷名)。入力変更のたびに更新される --}}
    <div class="tnx-damage-preview">
        <span class="tnx-damage-preview-label">最終ダメージ</span>
        <span class="tnx-damage-preview-note"></span>
        <span class="tnx-damage-preview-final">–</span>
    </div>
</div>
