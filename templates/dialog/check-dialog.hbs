{{#if noPending}}
<div class="check-no-pending">判定情報がありません。</div>
{{else}}
<div class="check-dialog-body">

    <div class="check-header">
        <span class="check-type-label">{{typeLabel}}</span>
        <span class="check-skill-label">{{skillLabel}}</span>
    </div>

    <div class="check-suits">
        {{#each validSuits as |s|}}
        <span class="check-suit-badge suit-{{s.key}}" title="{{s.name}}">{{s.symbol}}</span>
        {{/each}}
    </div>

    {{#if hasTargetValue}}
    <div class="check-tn">
        <span class="check-tn-label">目標値</span>
        <span class="check-tn-value">{{targetValue}}</span>
    </div>
    {{/if}}

    <div class="check-manual-mod">
        <label>{{manualModLabel}}</label>
        <div class="number-input-spinner">
            <button type="button" class="tnx-btn" data-action="modDecrement" aria-label="Decrease">-</button>
            <input type="number" name="checkManualMod" value="{{manualMod}}" min="-99" max="99">
            <button type="button" class="tnx-btn" data-action="modIncrement" aria-label="Increase">+</button>
        </div>
    </div>

    {{#if canAddComboSkills}}
    <div class="check-combo-skills">
        <label>組み合わせ技能</label>
        <div class="tnx-tag-field">
            {{#if addedSkillChips.length}}
            <div class="tnx-tag-list">
                {{#each addedSkillChips as |chip|}}
                <span class="tnx-tag">{{chip.label}}<a class="tnx-tag-remove" data-action="removeDialogSkill" data-skill-id="{{chip.id}}" title="外す"><i class="fas fa-times"></i></a></span>
                {{/each}}
            </div>
            {{/if}}
            <div class="tnx-tag-add-row">
                <select data-dialog-skill-add class="tnx-tag-add">
                    <option value="">＋ 技能を追加</option>
                    {{#each skillGroups as |group|}}
                    <optgroup label="{{group.label}}">
                        {{#each group.skills as |skill|}}
                        <option value="{{skill.id}}">{{skill.label}}</option>
                        {{/each}}
                    </optgroup>
                    {{/each}}
                </select>
            </div>
        </div>
    </div>
    {{/if}}

    {{#if stunOption}}
    <div class="check-stun-toggle">
        <label class="tnx-check-inline-toggle">
            <input type="checkbox" name="stunDeclared" {{#if stunOption.checked}}checked{{/if}}>
            <span>{{stunOption.label}}</span>
        </label>
    </div>
    {{/if}}

    <p class="check-hint">{{hint}}</p>

    <footer class="check-dialog-footer">
        <button type="button" class="tnx-btn" data-action="drawFromDeck">
            <i class="fas fa-cards-blank"></i> 山札から判定
        </button>
        {{#if hasTrump}}
        <button type="button" class="tnx-btn {{#if trumpMode}}active{{/if}}" data-action="toggleTrumpMode">
            <i class="fas fa-star"></i> 切り札を使う
        </button>
        {{/if}}
        <button type="button" class="tnx-btn" data-action="cancel">
            <i class="fas fa-times"></i> キャンセル
        </button>
    </footer>

</div>
{{/if}}
