{{!-- FS判定エディタ（FS判定シートと起動フォームで共用・2026-07-21）。
      配置は紙のシートの位置ではなくコントロールの性質で決める:
      ①概要=ラベル+入力の対（支援判定のタグ入力も含める） ②判定行=表 ③メモ=全幅 --}}
<div class="fs-editor">

    {{!-- ① 概要 --}}
    <fieldset class="tnx-fieldset">
        <legend>概要</legend>
        <div class="fs-grid">
            <div class="form-group">
                <label>制限</label>
                <input type="text" name="restriction" value="{{fs.restriction}}" placeholder="参加条件（省略可）">
            </div>
            <div class="form-group">
                <label>目標進行値</label>
                <div class="number-input-spinner">
                    <button type="button" class="tnx-btn" data-action="fsSpinDown" aria-label="減少">−</button>
                    <input type="number" name="targetProgress" value="{{fs.targetProgress}}" min="0" max="999">
                    <button type="button" class="tnx-btn" data-action="fsSpinUp" aria-label="増加">＋</button>
                </div>
            </div>
            <div class="form-group">
                <label>敗北条件</label>
                <select name="defeatType" class="fs-defeat-type">
                    {{#each defeatTypes}}
                        <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="form-group fs-defeat-cut">
                <label>敗北カット数</label>
                <div class="number-input-spinner">
                    <button type="button" class="tnx-btn" data-action="fsSpinDown" aria-label="減少">−</button>
                    <input type="number" name="cutLimit" value="{{fs.defeatCondition.cutLimit}}" min="0" max="999">
                    <button type="button" class="tnx-btn" data-action="fsSpinUp" aria-label="増加">＋</button>
                </div>
            </div>
            <div class="form-group fs-defeat-other">
                <label>敗北条件の内容</label>
                <input type="text" name="defeatText" value="{{fs.defeatCondition.text}}">
            </div>
            <div class="form-group">
                <label>敗北時の処理</label>
                <input type="text" name="defeatEffect" value="{{fs.defeatEffect}}" placeholder="（省略可）">
            </div>
            {{!-- 支援判定の指定技能（複数）。概要に統合し、全幅のタグ入力にする --}}
            <div class="form-group fs-support-group">
                <label>支援判定</label>
                <div class="fs-skill-tags">
                    {{#each supportRows}}
                        <span class="fs-support-row fs-skill-chip" data-key="{{this.key}}">
                            <span class="fs-skill-name">{{this.name}}</span>
                            {{#if ../editable}}
                                <a class="fs-skill-del" data-action="fsSupportDelete" data-key="{{this.key}}"
                                   title="削除"><i class="fas fa-times"></i></a>
                            {{/if}}
                        </span>
                    {{/each}}
                    {{#if editable}}
                        <select class="fs-support-add fs-skill-add">
                            <option value="">＋ 技能を追加</option>
                            {{#each supportChoices}}
                                <optgroup label="{{this.label}}">
                                    {{#each this.skills}}
                                        <option value="{{this.identificationKey}}">{{this.name}}</option>
                                    {{/each}}
                                </optgroup>
                            {{/each}}
                        </select>
                    {{else}}
                        {{#unless supportRows.length}}<span class="fs-empty">（指定なし）</span>{{/unless}}
                    {{/if}}
                </div>
            </div>
        </div>
    </fieldset>

    {{!-- ② イベント・進行判定 --}}
    <fieldset class="tnx-fieldset">
        <legend>イベント・進行判定</legend>
        <div class="fs-row-table-wrap">
            <table class="fs-row-table">
                <thead>
                    <tr>
                        <th class="fs-col-threshold">進行値</th>
                        <th class="fs-col-skill">技能</th>
                        <th class="fs-col-target">目標値</th>
                        <th class="fs-col-mod">進行修正</th>
                        <th class="fs-col-note">備考</th>
                        <th class="fs-col-ctrl"></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each rows}}
                        <tr class="fs-row" data-index="{{this.index}}" data-row-id="{{this.id}}">
                            <td>
                                <div class="number-input-spinner">
                                    <button type="button" class="tnx-btn" data-action="fsSpinDown" aria-label="減少">−</button>
                                    <input type="number" name="threshold" value="{{this.threshold}}" min="0" max="999">
                                    <button type="button" class="tnx-btn" data-action="fsSpinUp" aria-label="増加">＋</button>
                                </div>
                            </td>
                            <td class="fs-row-skill">
                                <div class="fs-skill-tags">
                                    {{#each this.skillRows}}
                                        <span class="fs-skill-chip" data-key="{{this.key}}">
                                            <span class="fs-skill-name">{{this.name}}</span>
                                            {{#if ../../editable}}
                                                <a class="fs-skill-del" data-action="fsRowSkillDelete" data-key="{{this.key}}"
                                                   title="削除"><i class="fas fa-times"></i></a>
                                            {{/if}}
                                        </span>
                                    {{/each}}
                                    {{#if ../editable}}
                                        <select class="fs-row-skill-add fs-skill-add">
                                            <option value="">＋ 技能を追加</option>
                                            {{#each this.skillChoices}}
                                                <optgroup label="{{this.label}}">
                                                    {{#each this.skills}}
                                                        <option value="{{this.identificationKey}}">{{this.name}}</option>
                                                    {{/each}}
                                                </optgroup>
                                            {{/each}}
                                        </select>
                                    {{else}}
                                        {{#unless this.skillRows.length}}<span class="fs-empty">（指定なし）</span>{{/unless}}
                                    {{/if}}
                                </div>
                            </td>
                            <td>
                                <div class="number-input-spinner">
                                    <button type="button" class="tnx-btn" data-action="fsSpinDown" aria-label="減少">−</button>
                                    <input type="number" name="targetValue" value="{{this.targetValue}}" min="0" max="99">
                                    <button type="button" class="tnx-btn" data-action="fsSpinUp" aria-label="増加">＋</button>
                                </div>
                            </td>
                            <td>
                                {{!-- 参照元＝なし の行はパラメータも式も使わないので、セルはプルダウン1つに収まる --}}
                                <select name="modSource" class="fs-mod-source">
                                    {{#each this.sources}}
                                        <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                                    {{/each}}
                                </select>
                                <div class="fs-mod-detail" {{#unless this.hasParam}}hidden{{/unless}}>
                                    <select name="modParam">
                                        {{#each this.paramGroups}}
                                            <optgroup label="{{this.label}}">
                                                {{#each this.params}}
                                                    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                                                {{/each}}
                                            </optgroup>
                                        {{/each}}
                                    </select>
                                    <input type="text" name="modFormula" value="{{this.progressMod.formula}}" placeholder="@param">
                                </div>
                            </td>
                            <td><input type="text" name="note" value="{{this.note}}"></td>
                            <td class="fs-row-ctrl">
                                {{#if ../editable}}
                                    <i class="fas fa-grip-vertical fs-row-grip" draggable="true" title="ドラッグで並び替え"></i>
                                    <a class="tnx-icon-ctrl" data-action="fsRowDelete" title="削除"><i class="fas fa-trash"></i></a>
                                {{/if}}
                            </td>
                        </tr>
                    {{else}}
                        <tr class="fs-row-empty"><td colspan="6">イベント・進行判定がありません</td></tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{#if editable}}
            <button type="button" class="tnx-btn tnx-btn--sm" data-action="fsRowAdd">
                <i class="fas fa-plus"></i> 追加
            </button>
        {{/if}}
    </fieldset>

    {{!-- ③ メモ --}}
    <fieldset class="tnx-fieldset">
        <legend>メモ</legend>
        <textarea name="memo" rows="3">{{fs.memo}}</textarea>
    </fieldset>

</div>
