<div class="tnx-bs-container">
    <div class="tnx-bs-grid">
        {{#each badStatuses as |bs|}}
        <button type="button"
            class="tnx-bs-btn {{#if ../isEditMode}}tnx-bs-btn--edit{{else}}tnx-bs-btn--view{{/if}}{{#if bs.ignored}} tnx-bs-btn--ignored{{/if}}"
            {{#if ../isEditMode}}data-action="removeBadStatus"{{/if}}
            data-effect-id="{{bs.id}}"
            data-status-id="{{bs.statusId}}"
            data-tooltip="{{bs.details}}">
            <img src="{{bs.img}}" class="tnx-bs-icon"/>
            {{! 効果名+効果値は一まとまりで中央寄せ。順序: BS=「効果名n」・ダメージ=「nチャート名」(valueFirst) }}
            <span class="tnx-bs-text-wrap"><span class="tnx-bs-text squeeze-text">{{#if bs.valueFirst}}{{#if bs.valueText}}<span class="tnx-bs-value">{{bs.valueText}}</span>{{/if}}{{/if}}<span class="tnx-bs-label">{{bs.name}}</span>{{#unless bs.valueFirst}}{{#if bs.valueText}}<span class="tnx-bs-value">{{bs.valueText}}</span>{{/if}}{{/unless}}</span></span>
            {{#if ../isEditMode}}<i class="fas fa-times tnx-bs-remove"></i>{{/if}}
        </button>
        {{/each}}

        {{#unless badStatuses.length}}
        <span class="tnx-bs-empty">
            現在受けているバッドステータスはありません。
        </span>
        {{/unless}}
    </div>
</div>
