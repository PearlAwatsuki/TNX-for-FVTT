{{!-- 対象選択(4つのダイアログで共通・2026-07-21)。Monks Token Bar を踏襲した表形式＋
      アイコンのみボタン(ラベルは title)。どのダイアログでも**一番下**に置く。
      行は bindTargetPicker が描画する --}}
<div class="tnx-target-picker">
    <div class="tnx-tp-head">
        <span class="tnx-tp-title">対象</span>
        <div class="tnx-tp-tools">
            <a class="tnx-tp-tool" data-collect="selected" title="選択したアクターを追加"><i class="fas fa-hand-pointer"></i></a>
            <a class="tnx-tp-tool" data-collect="targeted" title="ターゲットしたアクターを追加"><i class="fas fa-crosshairs"></i></a>
            <a class="tnx-tp-tool" data-collect="casts"    title="キャストをすべて追加"><i class="fas fa-users"></i></a>
            <a class="tnx-tp-tool" data-collect="pcs"      title="プレイヤーキャラクターをすべて追加"><i class="fas fa-user-group"></i></a>
            <a class="tnx-tp-tool" data-action="clearAll"  title="すべて外す"><i class="fas fa-trash"></i></a>
        </div>
    </div>
    <div class="tnx-tp-list"></div>
</div>
