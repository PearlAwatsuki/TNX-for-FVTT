{{!-- 対象選択リスト(4つのダイアログで共通・2026-07-21)。行は bindTargetPicker が描画する --}}
<div class="form-group rl-form-group tnx-target-picker">
    <label class="rl-label">対象</label>

    <div class="tnx-tp-list"></div>

    <div class="tnx-tp-buttons">
        <button type="button" class="tnx-btn tnx-btn--sm" data-collect="selected">
            <i class="fas fa-hand-pointer"></i> 選択したアクターを追加
        </button>
        <button type="button" class="tnx-btn tnx-btn--sm" data-collect="targeted">
            <i class="fas fa-crosshairs"></i> ターゲットしたアクターを追加
        </button>
        <button type="button" class="tnx-btn tnx-btn--sm" data-collect="casts">
            <i class="fas fa-users"></i> キャストをすべて追加
        </button>
        <button type="button" class="tnx-btn tnx-btn--sm" data-collect="pcs">
            <i class="fas fa-user-group"></i> プレイヤーキャラクターをすべて追加
        </button>
    </div>
</div>
