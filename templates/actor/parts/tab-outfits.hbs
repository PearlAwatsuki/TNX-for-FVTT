                <div class="tab outfits" data-group="primary" data-tab="outfits">
                    <div class="tnx-section-header">
                        <h3>所有アウトフィット</h3>
                        {{#if isEditMode}}
                        <a class="item-control item-create" data-action="addOutfit" title="アウトフィットを追加">
                            <i class="fas fa-plus"></i> 追加
                        </a>
                        {{/if}}
                    </div>

                    <div class="outfit-groups-container">
                        {{#each outfitGroups as |group|}}
                        <div class="outfit-group">
                            {{!-- カラムヘッダー --}}
                            <div class="outfit-row outfit-row--header">
                                <span class="outfit-col--name"><span class="squeeze-text">{{group.label}}</span></span>
                                {{#each group.columns as |col|}}
                                <span class="outfit-col--{{col.key}}"><span class="squeeze-text">{{col.label}}</span></span>
                                {{/each}}
                                <span class="outfit-col--flags"></span>
                                <span class="outfit-col--actions"></span>
                            </div>
                            {{!-- アイテム行 --}}
                            {{#each group.items as |row|}}
                            <div class="outfit-row{{#if row.isNested}} outfit-row--option{{#if row.isLastOption}} outfit-row--last-option{{/if}}{{/if}}" data-item-id="{{row._id}}">
                                <div class="outfit-row-main">
                                    <span class="outfit-col--name"><a class="squeeze-text check-trigger" data-action="startSkillCheck" data-item-id="{{row._id}}" title="使用（用途があれば実行・無ければ説明を表示）">{{row.displayName}}</a>{{#if row.housingAreaRank}}<span class="outfit-area-badge outfit-area-badge--{{row.housingAreaRank.key}}" title="住宅エリア：{{row.housingAreaRank.label}}">{{row.housingAreaRank.label}}</span>{{/if}}{{#each row.slotGauges}}<span class="outfit-slot-gauge outfit-slot-gauge--{{this.kind}}{{#if this.over}} is-over{{/if}}" title="{{this.kindLabel}} {{this.used}}/{{this.capacity}}">{{#each this.pips}}<i class="tnx-pip{{#if this.on}} on{{/if}}{{#if this.over}} over{{/if}}"></i>{{/each}}<b class="tnx-pip-count">{{this.used}}/{{this.capacity}}</b></span>{{/each}}{{#if row.slotLabel}}<span class="outfit-slot-tag outfit-slot-tag--{{row.slotKind}}">{{row.slotLabel}}</span>{{/if}}</span>
                                    {{#each row.colValues as |col|}}
                                    <span class="outfit-col--{{col.key}}"><span class="squeeze-text">{{col.value}}</span></span>
                                    {{/each}}
                                    <span class="outfit-col--flags">
                                        {{#unless row.isResidence}}
                                        <button type="button" class="outfit-flag-btn{{#if row.system.isCarrying}} active{{/if}}" data-action="toggleOutfitFlag" data-flag="isCarrying" title="携帯中"><i class="fa-solid fa-suitcase"></i></button>
                                        {{/unless}}
                                        {{!-- 部位「-」は準備できない=準備トグルを出さない(準備不要で常時適用・2026-07-09) --}}
                                        {{#unless row.system.isPartless}}
                                        <button type="button" class="outfit-flag-btn{{#if row.system.isPrepared}} active{{/if}}" data-action="toggleOutfitFlag" data-flag="isPrepared" title="準備済み" {{#unless row.system.isCarrying}}disabled{{/unless}}><i class="fa-solid fa-shield-halved"></i></button>
                                        {{/unless}}
                                    </span>
                                    <span class="outfit-col--actions">
                                        <button type="button" class="skill-desc-toggle" data-action="toggleOutfitDesc" title="説明を表示/非表示">
                                            <i class="fas fa-expand"></i>
                                        </button>
                                        <a class="item-menu-trigger" title="メニュー">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </a>
                                    </span>
                                </div>
                                <div class="outfit-desc-panel" style="display: none;">
                                    {{#if row.combineInfo}}
                                    <div class="outfit-combine-info">
                                        <i class="fas fa-link"></i>
                                        {{row.combineInfo.source1Name}} ＋ {{row.combineInfo.source2Name}}
                                        <span class="outfit-combine-info__combiner">（{{row.combineInfo.combinerName}}）</span>
                                    </div>
                                    {{/if}}
                                    <div class="outfit-desc-content">{{{row.description}}}</div>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                        {{/each}}
                    </div>

                    {{!-- 部位占有（タブ最下部・縮小/展開・既定縮小。表示のみ・超過は赤）。
                         部位管理を持たないシート(features.parts=false)では出さない --}}
                    {{#if features.parts}}
                    {{#if (or partOccupancy.hasSlots (or partOccupancy.hasHostChips isEditMode))}}
                    <div class="tnx-part-occupancy{{#unless partOccExpanded}} collapsed{{/unless}}">
                        <div class="tnx-occ-title" data-action="togglePartOccupancy">
                            <span class="tnx-occ-toggle"><i class="fas fa-chevron-right tnx-occ-chevron"></i> 部位の占有</span>
                            {{#if isEditMode}}
                            <span class="tnx-occ-actions">
                                <a class="tnx-occ-edit" data-action="editPartSlots" title="このキャストの部位スロットを編集">
                                    <i class="fas fa-pen"></i> 編集
                                </a>
                                <a class="tnx-occ-load" data-action="loadPartPreset" title="ゲーム設定の部位プリセットを読み込み、このキャストの部位スロットを作成（既存は置換）">
                                    <i class="fas fa-download"></i> プリセットを読み込む
                                </a>
                            </span>
                            {{/if}}
                        </div>
                        <div class="tnx-occ-body">
                            {{#if (or partOccupancy.hasSlots partOccupancy.hasHostChips)}}
                            <div class="tnx-occ-chips">
                                {{#each partOccupancy.slots as |slot|}}
                                <span class="tnx-occ-chip {{#if slot.over}}tnx-occ-over{{/if}}" title="{{slot.label}}　使用 {{slot.used}} / 保有 {{slot.count}}{{#if slot.over}}（超過）{{/if}}">
                                    <span class="tnx-occ-name">{{slot.label}}</span>
                                    <span class="tnx-occ-count">{{slot.used}}/{{slot.count}}</span>
                                </span>
                                {{/each}}
                                {{#each partOccupancy.unlisted as |u|}}
                                <span class="tnx-occ-chip tnx-occ-over" title="プリセット未登録の部位「{{u.label}}」を {{u.used}} 占有">
                                    <span class="tnx-occ-name">{{u.label}}</span>
                                    <span class="tnx-occ-count">{{u.used}}/–</span>
                                </span>
                                {{/each}}
                                {{!-- ②③ 装備先(ホスト)スロット: 「スロット名（ホスト名）」を身体部位と同じ列に並べる。超過は赤 --}}
                                {{#each partOccupancy.hostChips as |h|}}
                                <span class="tnx-occ-chip {{#if h.over}}tnx-occ-over{{/if}}" title="{{h.label}}　使用 {{h.used}} / 容量 {{h.capacity}}{{#if h.over}}（超過）{{/if}}">
                                    <span class="tnx-occ-name">{{h.label}}</span>
                                    <span class="tnx-occ-count">{{h.used}}/{{h.capacity}}</span>
                                </span>
                                {{/each}}
                            </div>
                            {{else}}
                            <div class="tnx-occ-empty">部位スロット未設定です。「プリセットを読み込む」で作成できます。</div>
                            {{/if}}
                        </div>
                    </div>
                    {{/if}}
                    {{/if}}
                </div>
