                <div class="tab combat" data-group="primary" data-tab="combat">
                    {{!-- 戦闘タブ(フェーズ10-5/10-6・2026-07-02 確定仕様)。
                         CS=公式プロファイルシートのCSボックス様式(カット進行中はグロー)。
                         武器=生身ライン(攻撃用/パリー用の書き換え元・通常武器の使用は用途に移管)。
                         一覧・効果系は他タブの領分で置かない。 --}}
                    <div class="cs-box{{#if system.combatSpeed.inCombat}} cs-box--cut{{/if}}">
                        <div class="cs-box__title">
                            <span class="cs-box__abbr">CS</span>
                            <span class="cs-box__name">コンバットスピード</span>
                        </div>
                        {{#if isEditMode}}
                        <div class="cs-cascade">
                            <div class="cs-cascade__row">
                                <label>CSベース</label>
                                <input type="number" value="{{system.combatSpeed.base}}" disabled>
                                <span class="cs-cascade__op">＋</span>
                                <label>修正</label>
                                <div class="number-input-spinner">
                                    <button type="button" class="tnx-btn" data-action="decrementField" data-field="system.combatSpeed.freeMod">-</button>
                                    <input type="number" name="system.combatSpeed.freeMod" value="{{system.combatSpeed.freeMod}}">
                                    <button type="button" class="tnx-btn" data-action="incrementField" data-field="system.combatSpeed.freeMod">+</button>
                                </div>
                                <span class="cs-cascade__op">＝</span>
                                <input type="number" value="{{system.combatSpeed.baseTotal}}" disabled>
                            </div>
                            <div class="cs-cascade__link">
                                <button type="button" class="tnx-btn tnx-btn--secondary" data-action="initCombatSpeed">
                                    <i class="fas fa-angles-down"></i> CSを決定
                                </button>
                            </div>
                            {{!-- CS/CSカレントは列共有グリッド: ラベル列は最長ラベルの実幅・全体を中央寄せ --}}
                            <div class="cs-cascade__aligned">
                                <label>CS</label>
                                <div class="number-input-spinner">
                                    <button type="button" class="tnx-btn" data-action="decrementField" data-field="system.combatSpeed.value">-</button>
                                    <input type="number" name="system.combatSpeed.value" value="{{system.combatSpeed.value}}">
                                    <button type="button" class="tnx-btn" data-action="incrementField" data-field="system.combatSpeed.value">+</button>
                                </div>
                                <span class="cs-cascade__note cs-cascade__aligned-note"><i class="fas fa-angles-down"></i> カット開始で自動セット</span>
                                <label>CSカレント</label>
                                <div class="number-input-spinner">
                                    <button type="button" class="tnx-btn" data-action="decrementField" data-field="system.combatSpeed.current">-</button>
                                    <input type="number" name="system.combatSpeed.current" value="{{system.combatSpeed.current}}">
                                    <button type="button" class="tnx-btn" data-action="incrementField" data-field="system.combatSpeed.current">+</button>
                                </div>
                            </div>
                        </div>
                        {{else}}
                        <div class="cs-box__value-row">
                            <span class="cs-box__value">{{system.combatSpeed.displayTotal}}</span>
                            {{#if system.combatSpeed.ghostIgnorable}}
                            <span class="cs-box__ignorable">（{{system.combatSpeed.ghostIgnorable}}）</span>
                            {{/if}}
                        </div>
                        {{/if}}
                    </div>

                    {{!-- AR ボックス(フェーズ11 追補)。CS ボックスの意匠・表示自動制御を踏襲:
                         カット進行中=現在AR(グロー)/それ以外=実効付与値。AR は付与型
                         (カット進行の開始時に付与・正本 Combat_Flow.md)のため基準の入力欄を持たず、
                         編集モードは 付与＋修正＝付与値 → 現在AR の連鎖で表す。 --}}
                    <div class="cs-box cs-box--ar{{#if system.actionRank.inCombat}} cs-box--cut{{/if}}">
                        <div class="cs-box__title">
                            <span class="cs-box__abbr">AR</span>
                            <span class="cs-box__name">アクションランク</span>
                        </div>
                        {{#if isEditMode}}
                        <div class="cs-cascade">
                            <div class="cs-cascade__row">
                                <label>付与</label>
                                <input type="number" value="{{system.actionRank.grantBase}}" disabled>
                                <span class="cs-cascade__op">＋</span>
                                <label>修正</label>
                                <div class="number-input-spinner">
                                    <button type="button" class="tnx-btn" data-action="decrementField" data-field="system.actionRank.freeMod">-</button>
                                    <input type="number" name="system.actionRank.freeMod" value="{{system.actionRank.freeMod}}">
                                    <button type="button" class="tnx-btn" data-action="incrementField" data-field="system.actionRank.freeMod">+</button>
                                </div>
                                <span class="cs-cascade__op">＝</span>
                                <input type="number" value="{{system.actionRank.maxTotal}}" disabled>
                            </div>
                            <div class="cs-cascade__aligned">
                                <span class="cs-cascade__note cs-cascade__aligned-note"><i class="fas fa-angles-down"></i> カット開始で自動セット</span>
                                <label>現在AR</label>
                                <div class="number-input-spinner">
                                    <button type="button" class="tnx-btn" data-action="decrementField" data-field="system.actionRank.value">-</button>
                                    <input type="number" name="system.actionRank.value" value="{{system.actionRank.value}}">
                                    <button type="button" class="tnx-btn" data-action="incrementField" data-field="system.actionRank.value">+</button>
                                </div>
                            </div>
                        </div>
                        {{else}}
                        <div class="cs-box__value-row">
                            {{#if system.actionRank.inCombat}}
                            <span class="cs-box__value">{{system.actionRank.value}}</span>
                            {{else}}
                            {{!-- カット進行外は AR を持たない(付与型・2026-07-03 裁定)＝「なし」表示 --}}
                            <span class="cs-box__value cs-box__value--none">—</span>
                            {{/if}}
                        </div>
                        {{/if}}
                    </div>

                    <div class="tnx-section-header"><h3>武器</h3></div>
                    <div class="combat-refs">
                        <div class="combat-ref-line">
                            <span class="combat-ref-line__kind">攻撃</span>
                            {{#if combatAttackRef._id}}
                            <a class="combat-ref-line__name check-trigger" data-action="startSkillCheck" data-item-id="{{combatAttackRef._id}}">{{combatAttackRef.name}}</a>
                            {{else}}
                            <span class="combat-ref-line__name">{{combatAttackRef.name}}</span>
                            {{/if}}
                            <span class="combat-ref-line__value">攻 {{combatAttackRef.attack}}</span>
                        </div>
                        <div class="combat-ref-line">
                            <span class="combat-ref-line__kind">パリー</span>
                            {{#if combatParryRef._id}}
                            <a class="combat-ref-line__name check-trigger" data-action="startSkillCheck" data-item-id="{{combatParryRef._id}}">{{combatParryRef.name}}</a>
                            {{else}}
                            <span class="combat-ref-line__name">{{combatParryRef.name}}</span>
                            {{/if}}
                            <span class="combat-ref-line__value">受 {{combatParryRef.guard}}</span>
                        </div>
                        {{#if isEditMode}}
                        <div class="combat-ref-edit">
                            <div class="combat-ref-edit__field">
                                <label>攻撃で使用</label>
                                <select name="system.weaponRefs.attackItemId">
                                    {{selectOptions combatWeaponChoices selected=system.weaponRefs.attackItemId}}
                                </select>
                            </div>
                            <div class="combat-ref-edit__field">
                                <label>パリーで使用</label>
                                <select name="system.weaponRefs.parryItemId">
                                    {{selectOptions combatWeaponChoices selected=system.weaponRefs.parryItemId}}
                                </select>
                            </div>
                        </div>
                        {{/if}}
                    </div>

                    <div class="tnx-section-header"><h3>防御力</h3></div>
                    <div class="combat-def-line">
                        <span class="combat-def-line__label">防(S／P／I)</span>
                        <span class="combat-def-line__value">{{combatDefenceTotal.S}}／{{combatDefenceTotal.P}}／{{combatDefenceTotal.I}}</span>
                    </div>

                    <div class="tnx-section-header"><h3>タイミングごとの使用技能・アウトフィット</h3></div>
                    <div class="combat-timings">
                        {{#each combatTimings as |b|}}
                        <div class="combat-timing-group{{#unless b.entries.length}} combat-timing-group--empty{{/unless}}">
                            <div class="combat-timing-group__label">{{b.label}}</div>
                            {{#if b.entries.length}}
                            <div class="combat-timing-group__entries">
                                {{#each b.entries as |e|}}
                                <a class="combat-timing-chip check-trigger{{#if e.isMove}} combat-timing-chip--move{{/if}}{{#if e.isReload}} combat-timing-chip--move{{/if}}" data-action="{{#if e.action}}{{e.action}}{{else}}startSkillCheck{{/if}}" data-item-id="{{e._id}}">{{e.name}}</a>
                                {{/each}}
                            </div>
                            {{/if}}
                        </div>
                        {{/each}}
                    </div>
                </div>
